@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@using Nulysa.Communications
@implements IAsyncDisposable
@inject IJSRuntime JS

<fieldset class="markdown-mail-editor">
    <legend>@Input.Language.Name</legend>
    @if (TemplateKind is null)
    {
        <label><input type="checkbox" @bind="Input.Enabled" /> @T("Include this language")</label>
    }
    @if (Input.Enabled)
    {
        <label for="@FieldId("subject")">@T("Subject")</label>
        <input id="@FieldId("subject")" @bind="Input.Subject" @bind:event="oninput" @bind:after="RefreshPreview" @ref="subject" maxlength="200" />
        @if (TemplateKind is { } kind)
        {
            var field = OperationalTemplates.Fields(kind).FirstOrDefault(x => x.Name == selectedField);
            <div class="compact-form">
                <label for="@FieldId("field")">@T("Template field")</label>
                <select id="@FieldId("field")" @bind="selectedField">
                    <option value="">@T("Choose a field")</option>
                    @foreach (var item in OperationalTemplates.Fields(kind))
                    {
                        <option value="@item.Name">@T(item.Label) ({{@item.Name}})@(item.Required ? $" · {T("Required in body")}" : "")</option>
                    }
                </select>
                <button type="button" class="secondary-action" disabled="@(field is null || field.Link)" @onclick="() => InsertField(field, true)">@T("Insert in subject")</button>
                <button type="button" class="secondary-action" disabled="@(field is null || previewing)" @onclick="() => InsertField(field, false)">@T("Insert in body")</button>
            </div>
            <p><small>@T("This template uses Liquid syntax.")
                <a href="https://shopify.github.io/liquid/" target="_blank" rel="noopener noreferrer">@T("Liquid documentation")</a>
            </small></p>
            @if (field is { Optional: true })
            {
                <p><small>@T("To hide a paragraph when this field is empty, put it between these markers on separate lines.")
                    <code>{% if @field.Name %}</code> <code>{% endif %}</code></small></p>
            }
        }
        <div class="markdown-panel">
            <div class="markdown-header">
                <div class="markdown-tabs" role="tablist" aria-label="@T("Message editor")" @ref="tabs">
                    <button type="button" role="tab" id="@FieldId("write-tab")" aria-controls="@FieldId("write-panel")"
                            aria-selected="@(!previewing)" tabindex="@(previewing ? -1 : 0)" @onclick="Write">@T("Write")</button>
                    <button type="button" role="tab" id="@FieldId("preview-tab")" aria-controls="@FieldId("preview-panel")"
                            aria-selected="@previewing" tabindex="@(previewing ? 0 : -1)" @onclick="Preview">@T("Preview")</button>
                </div>
                <markdown-toolbar class="markdown-formatting" for="@FieldId("body")" hidden="@previewing" aria-label="@T("Markdown formatting")">
                    <md-header level="2" title="@T("Heading")" aria-label="@T("Heading")"><MarkdownToolbarIcon Name="heading" /></md-header>
                    <md-bold title="@T("Bold")" aria-label="@T("Bold")"><MarkdownToolbarIcon Name="bold" /></md-bold>
                    <md-italic title="@T("Italic")" aria-label="@T("Italic")"><MarkdownToolbarIcon Name="italic" /></md-italic>
                    <span class="markdown-divider" aria-hidden="true"></span>
                    <md-quote title="@T("Quote")" aria-label="@T("Quote")"><MarkdownToolbarIcon Name="quote" /></md-quote>
                    <md-link title="@T("Link")" aria-label="@T("Link")"><MarkdownToolbarIcon Name="link" /></md-link>
                    <md-unordered-list title="@T("Bullet list")" aria-label="@T("Bullet list")"><MarkdownToolbarIcon Name="bullet" /></md-unordered-list>
                </markdown-toolbar>
            </div>
            <div class="markdown-body" id="@FieldId("write-panel")" role="tabpanel" aria-labelledby="@FieldId("write-tab")" hidden="@previewing">
                <label class="visually-hidden" for="@FieldId("body")">@T("Message body (Markdown)")</label>
                <textarea id="@FieldId("body")" @ref="body" @bind="Input.Source" @bind:event="oninput"
                          placeholder="@T("Write your message in Markdown…")" rows="12" maxlength="@MailMarkdown.SourceLimit"></textarea>
            </div>
            <div class="markdown-body" id="@FieldId("preview-panel")" role="tabpanel" aria-labelledby="@FieldId("preview-tab")" hidden="@(!previewing)" tabindex="0">
                @if (error is not null)
                {
                    <p role="alert">@ValidationText.Translate(error)</p>
                }
                else if (preview is not null)
                {
                    <p><strong>@T("Subject"):</strong> @preview.Subject</p>
                    @* RichMail emits only fixed tags, encoded text and validated links. Inline rendering lets it inherit the page theme. *@
                    <div class="markdown-preview">@((MarkupString)preview.Html)</div>
                }
            </div>
        </div>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public MarkdownMailInput Input { get; set; } = null!;
    [Parameter] public MailKind? TemplateKind { get; set; }
    [Parameter] public bool Newsletter { get; set; }

    private ElementReference subject;
    private ElementReference body;
    private string selectedField = "";
    private ElementReference tabs;
    private bool connected;
    private IJSObjectReference? module;
    private bool previewing;
    private string? error;
    private MailContent? preview;

    private string FieldId(string field) => $"markdown-{Input.Language.Code}-{field}";
    protected override void OnParametersSet() => RefreshPreview();

    private void RefreshPreview()
    {
        if (previewing)
            Preview();
    }

    private void Write() => previewing = false;

    private void Preview()
    {
        previewing = true;
        error = null;
        preview = null;
        try
        {
            preview = TemplateKind is { } kind
                ? OperationalTemplates.Preview(kind, new(Input.Language.Code, Input.Subject, Input.Source))
                : MailMarkdown.Preview(Input.ReadPreview(), Newsletter);
        }
        catch (ValidationException problem) { error = problem.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Input.Enabled)
        {
            connected = false;
            return;
        }
        if (connected)
            return;

        connected = true;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./scripts/mail-markdown.js");
        await module.InvokeVoidAsync("connectEditor", tabs, body);
    }

    private async Task InsertField(OperationalTemplateField? field, bool inSubject)
    {
        if (module is null || field is null)
            return;
        var marker = "{{" + field.Name + "}}";
        await module.InvokeVoidAsync("insertTemplateField", inSubject ? subject : body, marker,
            field.Link ? T(field.Label) : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
            return;
        try { await module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
