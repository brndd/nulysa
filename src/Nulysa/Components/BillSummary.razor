@using Nulysa.Billing

<article class="bill-summary">
    <div>
        <h3>@T("Invoice #{0} — {1}", Invoice.Invoice.Id, (Invoice.Invoice.ClosedAt is null ? "Open" : "Closed"))</h3>
        <p>@string.Join(" · ", Invoice.Lines.Where(line => line.Line.State is LineState.Open or LineState.Fulfilled).Select(line => line.Line.Description).Distinct())</p>
        @if (Invoice.Invoice.ClosedAt is null && Invoice.Invoice.DueOn is { } due) { <p>@T("Pay by {0}", UiText.Date(due))</p> }
        @if (Invoice.Invoice.ClosedAt is null && Invoice.Lines.Any(line => line.Line.State == LineState.Fulfilled && line.Line.Benefit == Benefit.Membership) && Invoice.Lines.Any(line => line.Line.Benefit != Benefit.Membership && line.Line.State == LineState.Open && line.Remaining > 0)) { <p>@T("Membership fee paid.")</p> }
    </div>
    <div class="bill-summary-actions">
        <p>@T("Remaining:") <strong>@T("{0} EUR", Invoice.Remaining.ToString("0.00"))</strong></p>
        <a href="@(DetailsUrl ?? $"/billing/invoices/{Invoice.Invoice.Id}")">@T("View bill and payment instructions")</a>
        <a href="@($"/billing/invoices/{Invoice.Invoice.Id}/pdf")">@T("Download current PDF")</a>
    </div>
</article>

@code {
    [Parameter] public string? DetailsUrl { get; set; }
    [Parameter, EditorRequired] public InvoiceView Invoice { get; set; } = null!;
}
