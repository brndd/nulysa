@inherits LayoutComponentBase
@inject IConfiguration Configuration

<header><a href="/">@Configuration["Association:Name"]</a></header>
<AuthorizeView Policy="Administrator">
    <Authorized><nav aria-label="Board administration"><a href="/admin/members">Member registry</a> · <a href="/admin/applications">Application review</a></nav></Authorized>
</AuthorizeView>
