@using Nulysa.Billing
@using System.Text.Json
@inject Nulysa.Membership.AssociationClock Clock

@if (Discounts.Count > 0)
{
    <section class="discount-summary" aria-labelledby="discounts-heading">
        <h2 id="discounts-heading">@T("Active and upcoming discounts")</h2>
        <ul>
            @foreach (var discount in Discounts)
            {
                <li><strong>@View.FeeNames.GetValueOrDefault(discount.FeeDefinitionId, T("Membership or service fee")):
                    @T(discount.Kind == DiscountKind.Percentage ? "{0:0.##}% discount" : "{0:0.00} EUR/month replacement price", discount.Value)</strong>
                    <span>@BillingDateText.Period(discount.StartsOn, discount.EndExclusive)</span>
                    @if (discount.StartsOn > Clock.Today) { <span>@T("Upcoming")</span> }
                    @foreach (var bill in AppliedBills(discount.Id))
                    {
                        <a href="@($"/billing/invoices/{bill.Invoice.Id}")">@T("Applied to outstanding bill #{0}", bill.Invoice.Id)</a>
                    }
                </li>
            }
        </ul>
        <small>@T("Applies only within these dates. Issued bills show the actual discounted charge.")</small>
    </section>
}

@code {
    [Parameter, EditorRequired] public BillingView View { get; set; } = null!;
    private List<Discount> Discounts => View.Discounts
        .Where(discount => discount.WithdrawnAt is null && discount.EndExclusive > Clock.Today)
        .OrderBy(discount => discount.StartsOn)
        .ToList();
    private IEnumerable<InvoiceView> AppliedBills(long discountId) => View.Invoices.Where(invoice => invoice.Invoice.ClosedAt is null &&
        invoice.Lines.Any(row => row.Line.State == LineState.Open &&
            (JsonSerializer.Deserialize<List<PriceSegment>>(row.Line.PricingJson) ?? []).Any(segment => segment.DiscountId == discountId)));
}
