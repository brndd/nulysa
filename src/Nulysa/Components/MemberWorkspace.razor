@using Nulysa.Membership

<AdminPageHeader Title="@Heading" Context="@Member.Name" Trail="@Trail" />
<div class="member-subject">
    <strong class="subject-name">@Member.Name <span>Member #@Member.Id</span></strong>
    <span>@Member.Email · Joined @Member.JoinedOn.ToString("d MMM yyyy")</span>
    @if (Member.PendingDeletionAt is not null) { <strong class="member-account-warning">Pending deletion; login and services blocked.</strong> }
</div>
<nav class="section-navigation" aria-label="Member workspace">
    @foreach (var page in RegistryNavigation.Sections)
    {
        <a href="@RegistryNavigation.MemberUrl(Member.Id, ReturnUrl, page.Section)" aria-current="@(Section == page.Section ? Title is null ? "page" : "location" : null)">@(page.Label)</a>
    }
</nav>

@code {
    [Parameter, EditorRequired] public RegistryEntry Member { get; set; } = null!;
    [Parameter] public string? ReturnUrl { get; set; }
    [Parameter] public MemberSection Section { get; set; }
    [Parameter] public string? Title { get; set; }
    private string Heading => Title ?? RegistryNavigation.Sections.Single(page => page.Section == Section).Label;
    private IReadOnlyList<BreadcrumbItem> Trail
    {
        get
        {
            List<BreadcrumbItem> items = [new("Member registry", RegistryNavigation.ReturnUrl(ReturnUrl))];
            if (Section == MemberSection.Overview && Title is null)
                items.Add(new(Member.Name));
            else
            {
                items.Add(new(Member.Name, RegistryNavigation.MemberUrl(Member.Id, ReturnUrl)));
                if (Title is not null)
                    items.Add(new(RegistryNavigation.Sections.Single(page => page.Section == Section).Label, RegistryNavigation.MemberUrl(Member.Id, ReturnUrl, Section)));
                items.Add(new(Heading));
            }
            return items;
        }
    }
}
