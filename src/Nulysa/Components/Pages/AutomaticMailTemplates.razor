@page "/admin/communications/templates"
@page "/admin/communications/templates/{TemplateKind}"
@attribute [Authorize(Policy = "Administrator")]
@rendermode @(new InteractiveServerRenderMode())
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nulysa.Communications
@inject IServiceScopeFactory Scopes
@inject AuthenticationStateProvider Authentication

<AdminPageHeader Title="@T("Automatic mail templates")" />
<AdminSectionTabs Destination="mail-templates" />
<p>@T("Edit the subject and Markdown body for each language. Preview uses sample values.")</p>
<ul>
    @foreach (var template in templates)
    {
        <li><a href="@($"/admin/communications/templates/{template.Kind}")" aria-current="@(current?.Kind == template.Kind ? "page" : null)">@MailKindLabel.Text(template.Kind)</a></li>
    }
</ul>

@if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
@if (status is not null) { <p role="status">@T(status)</p> }

@if (current is not null && selected is not null && input is not null)
{
    <h2>@MailKindLabel.Text(current.Kind)</h2>
    <nav aria-label="@T("Template language")">
        <ul>
            @foreach (var entry in current.Languages)
            {
                var language = UiLanguages.Find(entry.Source.Language)!;
                <li>
                    @if (entry == selected)
                    {
                        <span aria-current="page">@language.Name</span>
                    }
                    else
                    {
                        <a href="@($"/admin/communications/templates/{current.Kind}?language={language.Code}")">@language.Name</a>
                    }
                </li>
            }
        </ul>
    </nav>
    <p>@T(selected.Custom ? "Custom override" : "Shipped default")</p>
    @if (selected.Problem is not null)
    {
        <div class="status-panel operational-warning">
            <p>@T("This override is invalid. Automatic mail uses the shipped default until it is repaired.")</p>
            <p>@ValidationText.Translate(selected.Problem)</p>
        </div>
    }
    <form @onsubmit="Save" @onsubmit:preventDefault>
        <label for="template-fallback">@T("Fallback language")</label>
        <select id="template-fallback" @bind="fallback">
            @foreach (var entry in current.Languages)
            {
                <option value="@entry.Source.Language">@UiLanguages.Find(entry.Source.Language)!.Name</option>
            }
        </select>
        <MarkdownMailEditor @key="input" Input="input" TemplateKind="current.Kind" />
        <button type="submit" disabled="@(!RendererInfo.IsInteractive || busy)">@T("Save template")</button>
        @if (selected.Custom)
        {
            <button type="button" class="secondary-action" disabled="@(!RendererInfo.IsInteractive || busy)" @onclick="Reset">@T("Restore default for this language")</button>
        }
    </form>
}

@code {
    [Parameter] public string? TemplateKind { get; set; }
    [SupplyParameterFromQuery(Name = "language")] public string? RequestedLanguage { get; set; }

    private ClaimsPrincipal actor = null!;
    private IReadOnlyList<OperationalTemplateView> templates = [];
    private OperationalTemplateView? current;
    private OperationalTemplateLanguage? selected;
    private MarkdownMailInput? input;
    private string fallback = "";
    private string? error;
    private string? status;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        actor = (await Authentication.GetAuthenticationStateAsync()).User;
        await Reload();
    }

    protected override void OnParametersSet()
    {
        status = null;
        Open(UiLanguages.Find(RequestedLanguage)?.Code ?? UiLanguages.Current);
    }

    private async Task Reload()
    {
        await using var scope = Scopes.CreateAsyncScope();
        templates = await scope.ServiceProvider.GetRequiredService<OperationalTemplates>().List(actor);
    }

    private void Open(string language)
    {
        error = null;
        current = templates.SingleOrDefault(x => string.Equals(x.Kind.ToString(), TemplateKind, StringComparison.OrdinalIgnoreCase));
        if (current is null)
        {
            if (TemplateKind is not null)
                error = "Choose an automatic mail template.";
            return;
        }
        fallback = current.FallbackLanguage;
        selected = current.Languages.SingleOrDefault(x => x.Source.Language == language)
            ?? current.Languages.Single(x => x.Source.Language == fallback);
        input = new(UiLanguages.Find(selected.Source.Language)!, null, true, selected.Source.Subject, selected.Source.Body);
    }

    private Task Save() => Change(reset: false);
    private Task Reset() => Change(reset: true);

    private async Task Change(bool reset)
    {
        if (busy || current is null || input is null)
            return;
        busy = true;
        status = error = null;
        try
        {
            var kind = current.Kind;
            var source = new OperationalTemplateSource(input.Language.Code, input.Subject, input.Source);
            await using var scope = Scopes.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<OperationalTemplates>();
            if (reset)
                await service.Reset(actor, kind, source.Language);
            else
                await service.Save(actor, kind, source, fallback);
            await Reload();
            Open(source.Language);
            status = reset ? "Default template restored." : "Template saved.";
        }
        catch (ValidationException problem) { error = problem.Message; }
        finally { busy = false; }
    }
}
