@page "/Account/AccessDenied"
@attribute [AllowAnonymous]

<PageTitle>@T("Access denied")</PageTitle>
<h1>@T("Access denied")</h1>
<p>@T("Your account does not have permission to view this page.")</p>
<a href="/">@T("Return to the member portal")</a>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    protected override void OnInitialized() => HttpContext.Response.StatusCode = StatusCodes.Status403Forbidden;
}
