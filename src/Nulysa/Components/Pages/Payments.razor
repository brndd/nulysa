@page "/admin/payments"
@page "/admin/payments/import"
@page "/admin/payments/accounting"
@page "/admin/payments/retained-balances"
@attribute [Authorize(Policy = "Administrator")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities
@using Nulysa.Billing
@using Nulysa.Integrations
@inject Nulysa.Components.UiFeedback Feedback
@inject BillingQueries Queries
@inject AdministrationBillingQueries Administration
@inject BillingCommands Commands
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject Nulysa.Membership.AssociationClock Clock

<AdminPageHeader Title="@Title" />
<AdminSectionTabs Destination="@Destination" />
@if (notice is not null && Area != "review") { <p role="status" class="success-notice">@T(notice)</p> }
@if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
@if (Area == "review")
{
<h2>@T("Bank synchronization")</h2>
<ul>@foreach (var status in statuses) { <li>@T("{0} · {1} · last success: {2} · last attempt: {3}", status.Account, status.Status, (status.LastSuccess?.ToString("u") ?? T("Never")), status.LastAttempt?.ToString("u"))</li> }</ul>
@if (statuses.Count == 0) { <p>@T("No bank payments have been imported yet.")</p> }
<section aria-labelledby="payment-review" class="payment-review">
    <h2 id="payment-review">@T("Bank transactions")</h2>
    @if (notice is not null) { <p role="status" class="success-notice">@T(notice)</p> }
    @if (payments is { } list)
    {
        <nav class="balance-filter" aria-label="@T("Payment filter")">
            <a href="@(QueueUrl(1, all: false) + "#payment-review")" aria-current="@(!All ? "page" : null)">@T("Needs review")</a>
            <a href="@(QueueUrl(1, all: true) + "#payment-review")" aria-current="@(All ? "page" : null)">@T("All payments")</a>
        </nav>
        @if (list.Total == 0)
        {
            <p>@T(All ? "No payments found." : "No payments need review.")</p>
        }
        else
        {
            var queue = QueueUrl(list.Number);
            <div class="payment-review-scroll" role="region" aria-label="@T("Bank transactions")" tabindex="0">
                <table>
                    <thead><tr>
                        @foreach (var column in Columns)
                        {
                            var selected = Sort == column.Key;
                            <th scope="col" aria-sort="@(selected ? Descending ? "descending" : "ascending" : null)">
                                <a href="@(QueueUrl(1, column.Key, selected && !Descending) + "#payment-review")">@T(column.Label)
                                    @if (selected) { <span aria-hidden="true">@(Descending ? "↓" : "↑")</span> }
                                </a>
                            </th>
                        }
                    </tr></thead>
                    <tbody>
                        @foreach (var receipt in list.Entries)
                        {
                            var expanded = ReviewId == receipt.Id;
                            var anchor = RowAnchor(receipt.Id);
                            <tr id="@anchor[1..]">
                                <td>
                                    <span class="payment-booked-date">@UiText.Date(receipt.ReceivedOn)</span>
                                    <small>#@receipt.Id</small><br />
                                    <a href="@((expanded ? queue : QueryHelpers.AddQueryString(queue, "review", receipt.Id.ToString())) + anchor)"
                                       aria-expanded="@(expanded ? "true" : "false")">@T(expanded ? "Close" : NeedsReview(receipt) ? "Review" : "Details")</a>
                                </td>
                                <td class="payment-amount">@receipt.Amount.ToString("0.00") @receipt.Currency</td>
                                <td><span class="payment-review-excerpt">@receipt.Reference</span></td>
                                <td><span class="payment-review-excerpt">@receipt.Counterparty</span></td>
                                <td><span class="payment-review-excerpt">@receipt.Message</span></td>
                                <td><span class="payment-review-excerpt">@receipt.ReviewReason</span></td>
                                <td>@T(Status(receipt))</td>
                            </tr>
                            @if (expanded)
                            {
                                <tr class="payment-review-expanded"><td colspan="@Columns.Length">
                                    <ReceiptReview ReceiptId="receipt.Id" QueueUrl="@queue" />
                                </td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (list.PageCount > 1)
            {
                <nav class="section-pagination" aria-label="@T("Payment pages")">
                    @if (list.Number > 1) { <a href="@(QueueUrl(list.Number - 1) + "#payment-review")">@T("Previous")</a> }
                    <span>@T("Page {0} of {1}", list.Number, list.PageCount)</span>
                    @if (list.Number < list.PageCount) { <a href="@(QueueUrl(list.Number + 1) + "#payment-review")">@T("Next")</a> }
                </nav>
            }
        }
    }
</section>
}
@if (Area == "import")
{
<h2>@T("Import a confirmed bank transaction manually")</h2>
<p>@T("Use the bank's stable transaction ID and actual booked date. Reimporting the same source must not change its facts. Outgoing transactions use a negative amount and are retained for review.")</p>
<EditForm Model="Import" method="post" FormName="manual-receipt" OnValidSubmit="ImportReceipt"><DataAnnotationsValidator /><FormErrors />
    <p><label for="source">@T("Source/provider")</label> <InputText id="source" @bind-Value="Import!.Source" required /></p>
    <p><label for="source-account">@T("Source bank account ID")</label> <InputText id="source-account" @bind-Value="Import.SourceAccount" required /></p>
    <p><label for="external-id">@T("External transaction ID")</label> <InputText id="external-id" @bind-Value="Import.ExternalId" required /></p>
    <p><label for="received">@T("Bank receipt / booked date")</label> <InputDate id="received" @bind-Value="Import.ReceivedOn" /></p>
    <p><label for="received-amount">@T("Amount")</label> <InputMoney id="received-amount" @bind-Value="Import.Amount" /> <label for="currency">@T("Currency")</label> <InputText id="currency" @bind-Value="Import.Currency" maxlength="3" /></p>
    <p><label for="reference">@T("Original reference")</label> <InputText id="reference" @bind-Value="Import.Reference" maxlength="200" /></p>
    <p><label for="message">@T("Bank message")</label> <InputTextArea id="message" @bind-Value="Import.Message" maxlength="4000" /></p>
    <p><label for="counterparty">@T("Counterparty (recipient for outgoing transfers)")</label> <InputText id="counterparty" @bind-Value="Import.Counterparty" maxlength="1000" /></p><button>@T("Import source fact and match")</button>
</EditForm>
}
@if (Area == "accounting")
{
<h2>@T("Journal reconciliation")</h2>
@if (reconciliation is { } r)
{
    <dl><dt>@T("Posted receipts")</dt><dd>@T("{0} EUR", r.Receipts)</dd><dt>@T("Billing credit / purchase balance / held advances")</dt><dd>@T("{0} / {1} / {2} EUR", r.BillingCredit, r.PurchaseBalance, r.Held)</dd>
        <dt>@T("Completed purchases / credit corrections / refunds")</dt><dd>@T("{0} / {1} / {2} EUR", r.Purchases, r.Corrections, r.Refunds)</dd><dt>@T("Unexplained difference")</dt><dd>@T("{0} EUR", r.Difference)</dd></dl>
    @if (r.InvalidLines.Count > 0 || r.InvalidReceipts.Count > 0) { <p role="alert">@T("Investigate lines {0} and receipts {1}. No automatic repairs were applied.", string.Join(", ", r.InvalidLines), string.Join(", ", r.InvalidReceipts))</p> }
}
<p>@T("Reconciliation above is lifetime-to-date. CSV ranges use movement effective dates or bank booked dates, not processing timestamps. Bank export includes ignored/outgoing transactions and review dispositions.")</p>
<form method="get" action="/admin/payments/export"><label for="export-start">@T("From")</label> <input id="export-start" type="date" name="start" required /> <label for="export-end">@T("Before")</label> <input id="export-end" type="date" name="end" required /> <button>@T("Export journal CSV")</button> <button formaction="/admin/payments/receipts-export">@T("Export bank transactions CSV")</button></form>
}
@if (Area == "claims")
{
<h2>@T("Balances retained after account erasure")</h2>
<p>@T("These financial claims do not restore accounts or recognize returning applicants. Refunds require treasurer verification.")</p>
<ul>@foreach (var claim in claims) { <li><a href="@($"/admin/payments/retained-balances/{claim.AccountId}")">@T("Account #{0}", claim.AccountId)</a> @T("· {0} · {1} · billing {2} EUR · purchase {3} EUR", claim.Name, claim.Email, claim.BillingCredit, claim.PurchaseBalance)</li> }</ul>

}
