@page "/admin/settings/fees"
@page "/admin/settings/fees/{Id:long}"
@attribute [Authorize(Policy = "Administrator")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nulysa.Billing
@inject BillingQueries Queries
@inject BillingCommands Commands
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject Nulysa.Membership.AssociationClock Clock
@inject UiFeedback Feedback

<AdminPageHeader Title="@Title" Trail="@Trail" />
@if (Id is null) { <AdminSectionTabs Destination="fees" /> }
@if (notice is not null) { <p role="status" class="success-notice">@T(notice)</p> }
@if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
@if (Id is null)
{
    <table tabindex="0"><caption>@T("Fees and current prices")</caption><thead><tr><th scope="col">@T("Fee")</th><th scope="col">@T("Category")</th><th scope="col">@T("Current monthly price EUR")</th><th scope="col">@T("State")</th></tr></thead><tbody>
    @foreach (var fee in fees)
    {
        var current = prices.Where(price => price.FeeDefinitionId == fee.Id && price.EffectiveOn <= Clock.Today).OrderByDescending(price => price.EffectiveOn).FirstOrDefault();
        <tr><td><a href="@($"/admin/settings/fees/{fee.Id}")">@fee.Name</a></td><td>@fee.Category</td><td>@(current?.MonthlyAmount.ToString("0.00") ?? T("Not configured"))</td><td>@(fee.Retired ? T("Retired") : T("Active"))</td></tr>
    }
    </tbody></table>
}
else if (selected is not null)
{
    <div class="detail-workspace">
    @if (selected.ServiceDefinitionId is { } serviceId) { <p><a href="@($"/admin/settings/services/{serviceId}")">@T("Edit service definition")</a></p> }
    <table tabindex="0"><caption>@T("Price history for {0}", selected.Name)</caption><thead><tr><th scope="col">@T("Effective from")</th><th scope="col">@T("Monthly price EUR")</th></tr></thead><tbody>
    @foreach (var price in prices.Where(price => price.FeeDefinitionId == Id).OrderByDescending(price => price.EffectiveOn)) { <tr><td>@price.EffectiveOn</td><td>@price.MonthlyAmount.ToString("0.00")</td></tr> }
    </tbody></table>
    <h2>@T("Add a dated price")</h2>
    <EditForm Model="Price" method="post" FormName="price" OnValidSubmit="SavePrice"><DataAnnotationsValidator /><FormErrors />
        <label for="price-date">@T("Effective from")</label><InputDate id="price-date" @bind-Value="Price!.EffectiveOn" />
        <label for="price">@T("Monthly EUR")</label><InputMoney id="price" @bind-Value="Price.Amount" />
        <button>@T("Add price")</button>
    </EditForm>
    <p><a href="/admin/settings/fees">@T("Back to fees and prices")</a></p>
    </div>
}

@code {
    public sealed class PriceInput
    {
        public DateOnly EffectiveOn { get; set; }
        [MoneyRange("0", "999999999")] public MoneyAmount Amount { get; set; }
    }
    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromForm(FormName = "price")] public PriceInput? Price { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    private ClaimsPrincipal actor = null!;
    private List<FeeDefinition> fees = [];
    private List<FeePrice> prices = [];
    private FeeDefinition? selected;
    private string? error;
    private string? notice;
    private string Title => Id is null ? T("Fees and prices") : selected is null ? T("Fee prices") : T("{0} prices", selected.Name);
    private IReadOnlyList<BreadcrumbItem> Trail => Id is null ? [] : [new(T("Fees and prices"), "/admin/settings/fees"), new(Title)];

    protected override async Task OnInitializedAsync()
    {
        actor = (await Authentication.GetAuthenticationStateAsync()).User;
        notice = Feedback.Read(HttpContext);
        fees = await Queries.Fees(actor);
        prices = await Queries.Prices(actor);
        selected = fees.SingleOrDefault(fee => fee.Id == Id);
        if (Id is not null && selected is null)
            HttpContext.Response.StatusCode = 404;
        Price ??= new() { EffectiveOn = Clock.Today };
    }

    private async Task SavePrice()
    {
        if (selected is null)
            return;
        try
        {
            await Commands.SetPrice(actor, selected.Id, Price!.EffectiveOn, Price.Amount);
            Feedback.Save(HttpContext, "Dated price saved. Issued bills retain their quoted prices.");
            Navigation.NavigateTo(Navigation.Uri);
        }
        catch (ValidationException ex)
        {
            error = ex.Message;
        }
    }
}
