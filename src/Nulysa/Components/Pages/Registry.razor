@page "/admin/members"
@attribute [Authorize(Policy = "Administrator")]
@using Nulysa.Membership
@using Microsoft.AspNetCore.WebUtilities
@inject MembershipQueries Queries
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration
@inject Nulysa.Components.UiFeedback Feedback

<AdminPageHeader Title="@T("Member registry")" />
<AdminSectionTabs Destination="registry" />
<p class="page-intro">@T("Find a member to maintain their details, review membership and services, or manage payments. Standing uses current membership coverage and grace; unpaid optional services do not make membership inactive.")</p>
@if (notice is not null) { <p role="status" class="success-notice">@T(notice)</p> }
<form method="get" action="/admin/members" class="filter-panel">
    <div class="filter-fields">
        <div><label for="member-search">@T("Search name, email or member ID")</label><input id="member-search" name="q" value="@Search" maxlength="200" /></div>
        <div><label for="member-state">@T("Membership lifecycle")</label>
            <select id="member-state" name="state" value="@State">
                <option value="all" selected="@(State == "all")">@T("All members")</option>
                <option value="active" selected="@(State == "active")">@T("Active (including grace)")</option>
                <option value="inactive" selected="@(State == "inactive")">@T("Inactive members")</option>
                <option value="pending-deletion" selected="@(State == "pending-deletion")">@T("Pending deletion")</option>
            </select>
        </div>
        <div><label for="inactive-days">@T("Minimum days inactive")</label><input id="inactive-days" name="inactiveDays" type="number" min="0" max="36500" value="@InactiveDays" aria-describedby="inactive-help" /></div>
        <div><label for="member-sort">@T("Sort members")</label>
            <select id="member-sort" name="sort" value="@Sort">
                <option value="attention" selected="@(Sort == "attention")">@T("Pending deletion, then longest inactive")</option>
                <option value="name" selected="@(Sort == "name")">@T("Name")</option>
                <option value="newest" selected="@(Sort == "newest")">@T("Most recently joined")</option>
            </select>
        </div>
        <div><label for="page-size">@T("Members per page")</label>
            <select id="page-size" name="pageSize" value="@PageSize">
                @foreach (var size in new[] { 25, 50, 100 }) { <option value="@size" selected="@(PageSize == size)">@size</option> }
            </select>
        </div>
    </div>
    <p id="inactive-help" class="field-help">@T("Minimum days applies to the Inactive members filter. Use 0 for all inactive members, including those without a known inactivity date. This filter never terminates membership or starts deletion.")</p>
    <div class="filter-actions"><button type="submit">@T("Search members")</button><a href="/admin/members">@T("Clear filters")</a></div>
</form>
@if (result is not null)
{
    @if (result.Total == 0)
    {
        <p class="status-panel">@T("No members match these filters. Try a broader search or clear the filters.")</p>
    }
    else
    {
        <p id="registry-results">@T("Showing {0}–{1} of {2} members.", ((result.Page - 1) * result.PageSize + 1), Math.Min(result.Page * result.PageSize, result.Total), result.Total)</p>
        <div class="registry-list" aria-describedby="registry-results">
            @foreach (var member in result.Entries)
            {
                <article class="registry-member">
                    <div>
                        <h2><a href="@RegistryNavigation.MemberUrl(member.Id, ListUrl(result.Page))">@member.Name <span>@T("Member #{0}", member.Id)</span></a></h2>
                        <p>@member.Email</p>
                        <p class="field-help">@T("Joined {0}", UiText.Date(member.JoinedOn))</p>
                    </div>
                    <div class="registry-standing">
                        @if (member.PendingDeletionAt is not null)
                        {
                            <strong>@T("Pending deletion")</strong><p>@T("Login and services blocked.")</p>
                        }
                        else
                        {
                            <strong>@T(member.Standing!.Description)</strong>
                            @if (member.Standing.InactiveSince is { } since) { <p>@T("Inactive since {0}", UiText.Date(since))</p> }
                            @if (member.Standing.ActiveUntilExclusive is not null) { <p><StandingThroughDate Standing="member.Standing" /></p> }
                        }
                    </div>
                </article>
            }
        </div>
        <nav class="section-pagination" aria-label="@T("Registry pages")">
            @if (result.Page > 1) { <a href="@ListUrl(result.Page - 1)">@T("Previous members")</a> }
            <span>@T("Page {0} of {1}", result.Page, result.PageCount)</span>
            @if (result.Page < result.PageCount) { <a href="@ListUrl(result.Page + 1)">@T("Next members")</a> }
        </nav>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? RequestedState { get; set; }
    [SupplyParameterFromQuery(Name = "inactiveDays")] public string? RequestedInactiveDays { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? RequestedSort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? RequestedPage { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public string? RequestedPageSize { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    private string State => RequestedState is "active" or "inactive" or "pending-deletion" ? RequestedState : "all";
    private string Sort => RequestedSort is "name" or "newest" ? RequestedSort : "attention";
    private int InactiveDays => int.TryParse(RequestedInactiveDays, out var days) ? Math.Clamp(days, 0, 36500) : 0;
    private int PageSize => int.TryParse(RequestedPageSize, out var size) && size is 25 or 50 or 100 ? size : 25;
    private RegistryPage? result;
    private string? notice;

    protected override async Task OnParametersSetAsync()
    {
        notice = Feedback.Read(HttpContext);
        var page = int.TryParse(RequestedPage, out var number) ? number : 1;
        result = await Queries.Registry((await Authentication.GetAuthenticationStateAsync()).User, Search, State, InactiveDays, Sort, page, PageSize);
    }

    private string ListUrl(int page) => QueryHelpers.AddQueryString("/admin/members", new Dictionary<string, string?>
    {
        ["q"] = Search,
        ["state"] = State,
        ["inactiveDays"] = InactiveDays.ToString(),
        ["sort"] = Sort,
        ["page"] = page.ToString(),
        ["pageSize"] = PageSize.ToString()
    });
}
