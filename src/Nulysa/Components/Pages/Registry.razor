@page "/admin/members"
@attribute [Authorize(Policy = "Administrator")]
@using Nulysa.Membership
@using Microsoft.AspNetCore.WebUtilities
@inject MembershipQueries Queries
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration
@inject Nulysa.Components.UiFeedback Feedback

<PageTitle>Member registry — @Configuration["Association:Name"]</PageTitle>
<h1>Member registry</h1>
<p class="page-intro">Find a member to maintain their details, review membership and services, or manage payments. Standing uses current membership coverage and grace; unpaid optional services do not make membership inactive.</p>
@if (notice is not null) { <p role="status" class="success-notice">@notice</p> }
<form method="get" action="/admin/members" class="filter-panel">
    <div class="filter-fields">
        <div><label for="member-search">Search name, email or member ID</label><input id="member-search" name="q" value="@Search" maxlength="200" /></div>
        <div><label for="member-state">Membership lifecycle</label>
            <select id="member-state" name="state" value="@State">
                <option value="all" selected="@(State == "all")">All members</option>
                <option value="active" selected="@(State == "active")">Active (including grace)</option>
                <option value="inactive" selected="@(State == "inactive")">Inactive members</option>
                <option value="pending-deletion" selected="@(State == "pending-deletion")">Pending deletion</option>
            </select>
        </div>
        <div><label for="inactive-days">Minimum days inactive</label><input id="inactive-days" name="inactiveDays" type="number" min="0" max="36500" value="@InactiveDays" aria-describedby="inactive-help" /></div>
        <div><label for="member-sort">Sort members</label>
            <select id="member-sort" name="sort" value="@Sort">
                <option value="attention" selected="@(Sort == "attention")">Pending deletion, then longest inactive</option>
                <option value="name" selected="@(Sort == "name")">Name</option>
                <option value="newest" selected="@(Sort == "newest")">Most recently joined</option>
            </select>
        </div>
        <div><label for="page-size">Members per page</label>
            <select id="page-size" name="pageSize" value="@PageSize">
                @foreach (var size in new[] { 25, 50, 100 }) { <option value="@size" selected="@(PageSize == size)">@size</option> }
            </select>
        </div>
    </div>
    <p id="inactive-help" class="field-help">Minimum days applies to the Inactive members filter. Use 0 for all inactive members, including those without a known inactivity date. This filter never terminates membership or starts deletion.</p>
    <div class="filter-actions"><button type="submit">Search members</button><a href="/admin/members">Clear filters</a></div>
</form>
@if (result is not null)
{
    @if (result.Total == 0)
    {
        <p class="status-panel">No members match these filters. Try a broader search or clear the filters.</p>
    }
    else
    {
        <p id="registry-results">Showing @((result.Page - 1) * result.PageSize + 1)–@Math.Min(result.Page * result.PageSize, result.Total) of @result.Total members.</p>
        <div class="registry-list" aria-describedby="registry-results">
            @foreach (var member in result.Entries)
            {
                <article class="registry-member">
                    <div>
                        <h2><a href="@RegistryNavigation.MemberUrl(member.Id, ListUrl(result.Page))">@member.Name <span>Member #@member.Id</span></a></h2>
                        <p>@member.Email</p>
                        <p class="field-help">Joined @member.JoinedOn.ToString("d MMM yyyy")</p>
                    </div>
                    <div class="registry-standing">
                        @if (member.PendingDeletionAt is not null)
                        {
                            <strong>Pending deletion</strong><p>Login and services blocked.</p>
                        }
                        else
                        {
                            <strong>@member.Standing!.Description</strong>
                            @if (member.Standing.InactiveSince is { } since) { <p>Inactive since @since.ToString("d MMM yyyy")</p> }
                            @if (member.Standing.Until is { } until) { <p>Through @until.AddDays(-1).ToString("d MMM yyyy")</p> }
                        }
                    </div>
                </article>
            }
        </div>
        <nav class="section-pagination" aria-label="Registry pages">
            @if (result.Page > 1) { <a href="@ListUrl(result.Page - 1)">Previous members</a> }
            <span>Page @result.Page of @result.PageCount</span>
            @if (result.Page < result.PageCount) { <a href="@ListUrl(result.Page + 1)">Next members</a> }
        </nav>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? RequestedState { get; set; }
    [SupplyParameterFromQuery(Name = "inactiveDays")] public string? RequestedInactiveDays { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? RequestedSort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? RequestedPage { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public string? RequestedPageSize { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    private string State => RequestedState is "active" or "inactive" or "pending-deletion" ? RequestedState : "all";
    private string Sort => RequestedSort is "name" or "newest" ? RequestedSort : "attention";
    private int InactiveDays => int.TryParse(RequestedInactiveDays, out var days) ? Math.Clamp(days, 0, 36500) : 0;
    private int PageSize => int.TryParse(RequestedPageSize, out var size) && size is 25 or 50 or 100 ? size : 25;
    private RegistryPage? result;
    private string? notice;

    protected override async Task OnParametersSetAsync()
    {
        notice = Feedback.Read(HttpContext);
        var page = int.TryParse(RequestedPage, out var number) ? number : 1;
        result = await Queries.Registry((await Authentication.GetAuthenticationStateAsync()).User, Search, State, InactiveDays, Sort, page, PageSize);
    }

    private string ListUrl(int page) => QueryHelpers.AddQueryString("/admin/members", new Dictionary<string, string?>
    {
        ["q"] = Search,
        ["state"] = State,
        ["inactiveDays"] = InactiveDays.ToString(),
        ["sort"] = Sort,
        ["page"] = page.ToString(),
        ["pageSize"] = PageSize.ToString()
    });
}
