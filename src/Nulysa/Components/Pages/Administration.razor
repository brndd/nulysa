@page "/admin"
@attribute [Authorize(Policy = "Administrator")]
@using Nulysa.Membership
@inject BoardQueries Queries
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration

<PageTitle>@T("Needs attention") — @Configuration["Association:Name"]</PageTitle>
<h1>@T("Needs attention")</h1>
@if (attention is not null)
{
    <nav class="attention-queues" aria-label="@T("Board work queues")">
        <a href="/admin/applications"><strong>@attention.Applications</strong><span>@T(attention.Applications == 1 ? "Verified application" : "Verified applications")</span><small>@T("Review admission decisions")</small></a>
        <a href="/admin/payments#payment-review"><strong>@attention.PaymentReviews</strong><span>@T(attention.PaymentReviews == 1 ? "Payment to review" : "Payment exceptions")</span><small>@T("Review unmatched bank transactions")</small></a>
        <div class="attention-queue">
            <a href="@($"/admin/members?state=inactive&inactiveDays={InactiveDays}")"><strong>@attention.InactiveMembers</strong><span>@T(attention.InactiveMembers == 1 ? "Member with unpaid membership fees" : "Members with unpaid membership fees")</span><small>@T("Inactive for at least {0} days", InactiveDays)</small></a>
            <details class="queue-filter"><summary>@T("Adjust threshold")</summary>
                <form method="get" action="/admin" class="compact-form">
                    <label for="inactive-days">@T("Inactivity review threshold (days)")</label>
                    <input id="inactive-days" name="inactiveDays" type="number" min="1" max="36500" value="@InactiveDays" />
                    <button class="secondary-action">@T("Apply")</button>
                </form>
            </details>
        </div>
        <a href="/admin/members?state=pending-deletion"><strong>@attention.PendingDeletions</strong><span>@T(attention.PendingDeletions == 1 ? "Account marked for deletion" : "Pending deletions")</span><small>@T("Review before the erasure batch")</small></a>
        <a href="/admin/mail-attention"><strong>@attention.EssentialMailProblems</strong><span>@T(attention.EssentialMailProblems == 1 ? "Important email problem" : "Essential mail problems")</span><small>@T("Reconcile failed or uncertain delivery")</small></a>
    </nav>
    <section id="bank-sync" aria-labelledby="bank-heading">
        <h2 id="bank-heading">@T("Bank synchronization")</h2>
        @if (!attention.BankEnabled)
        {
            <p class="status-panel"><strong>@T("Automatic bank import is disabled.")</strong> @T("Payment standing depends on confirmed transactions imported manually. Contact the system operator to configure the feed.")</p>
        }
        @if (attention.BankAccounts.Count == 0)
        {
            <p>@T("No successful bank synchronization has been recorded. An empty payment-review queue does not establish that payments are up to date.")</p>
        }
        else
        {
            <p>@T("A last success more than {0} hours ago is shown as stale. Times below are UTC.", attention.StaleHours)</p>
            @foreach (var account in attention.BankAccounts)
            {
                <div class="status-panel @(attention.BankEnabled && account.NeedsAttention ? "operational-warning" : "")">
                    <h3>@T("Bank account") <span class="supporting-reference">@account.Account</span></h3>
                    <p><strong>@T(account.Stale ? "Stale — payment information may be incomplete" : account.NeedsAttention ? "Synchronization needs attention" : "Recent successful synchronization")</strong></p>
                    <p>@T("Last successful sync:") <strong>@(account.LastSuccess?.ToString("u") ?? T("Never — no successful sync recorded"))</strong><br />
                        @T("Last attempt: {0}", (account.LastAttempt?.ToString("u") ?? T("None recorded")))<br />
                        @T("Last recorded state: {0}", account.Status)
                    </p>
                    @if (attention.BankEnabled && account.NeedsAttention) { <p>@T("Ask the system operator to check the feed and provider authorization. Review confirmed bank transactions before changing member funds.")</p> }
                </div>
            }
        }
        <p><a href="/admin/payments">@T("Open payments and accounting")</a></p>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "inactiveDays")] public string? RequestedInactiveDays { get; set; }
    private int InactiveDays => int.TryParse(RequestedInactiveDays, out var days) ? Math.Clamp(days, 1, 36500) : 30;
    private BoardAttention? attention;

    protected override async Task OnParametersSetAsync()
    {
        attention = await Queries.Attention((await Authentication.GetAuthenticationStateAsync()).User, InactiveDays);
    }
}
