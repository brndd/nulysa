@page "/admin/members/{UserId:long}/actions"
@page "/admin/members/{UserId:long}/actions/{RequestedTask}"
@page "/admin/payments/retained-balances/{AccountId:long}"
@page "/admin/payments/retained-balances/{AccountId:long}/{RequestedTask}"
@attribute [Authorize(Policy = "Administrator")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nulysa.Billing
@inject AdministrationBillingQueries Administration
@inject Nulysa.Membership.MembershipQueries Members
@inject UiFeedback Feedback
@inject BillingQueries Queries
@inject BillingCommands Commands
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject Nulysa.Membership.AssociationClock Clock

@if (subject is not null)
{
    <MemberWorkspace Member="subject" ReturnUrl="@ReturnUrl" Section="MemberSection.Actions" Title="@(TaskName.Length > 0 ? Title : null)" />
}
else
{
    <AdminPageHeader Title="@Title" Trail="@(TaskName.Length > 0
        ? new BreadcrumbItem[] { new(T("Retained balances"), "/admin/payments/retained-balances"), new($"Account #{AccountId}", DirectoryUrl), new(Title) }
        : new BreadcrumbItem[] { new(T("Retained balances"), "/admin/payments/retained-balances"), new(Title) })" />
}
@if (notice is not null) { <p role="status" class="success-notice">@T(notice)</p> }
@if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
<div class="detail-workspace">
@if (view is not null)
{
    @if (UserId is null)
    {
        <p>@T("Retained financial account #{0}. The member account was erased. Only financial evidence and any unspent claim remain.", AccountId)</p>
        <table tabindex="0"><caption>@T("Retained invoice evidence")</caption><thead><tr><th scope="col">@T("Invoice / PDF")</th><th scope="col">@T("Line / period")</th><th scope="col">@T("State")</th><th scope="col">@T("Amount EUR")</th></tr></thead><tbody>
        @foreach (var invoice in view.Invoices) { @foreach (var row in invoice.Lines) { <tr><td><a href="@($"/billing/invoices/{invoice.Invoice.Id}/pdf")">#@invoice.Invoice.Id</a></td><td>#@row.Line.Id @row.Line.Description · @BillingDateText.PurchasePeriod(row.Line)</td><td>@T(row.Line.State.ToString())</td><td>@row.Line.Amount.ToString("0.00")</td></tr> } }
        </tbody></table>
    }
    <p>@T("Available billing credit: {0} EUR · purchase balance: {1} EUR · held: {2} EUR", view.Balances.BillingCredit.ToString("0.00"), view.Balances.PurchaseBalance.ToString("0.00"), view.Balances.Held.ToString("0.00"))</p>
    @if (TaskName.Length == 0)
    {
        @foreach (var group in TaskGroups)
        {
            var tasks = group.Tasks.Where(task => UserId is not null || task is "refund" or "unassign").ToList();
            @if (tasks.Count > 0)
            {
                <section><h2>@T(group.Label)</h2><ul class="task-list">
                @foreach (var task in tasks) { <li><a href="@ActionUrl(task)">@T(Actions[task])</a></li> }
                </ul></section>
            }
        }
    }
    <section id="adjustment">
    @if (TaskName == "one-off" && view.UserId is not null)
    {
        <p>@T("Issue a separate advance request with its own reference. No subscription, reservation or debt is created.")</p>
        <EditForm Model="OneOff" method="post" FormName="one-off" OnValidSubmit="CreateOneOff"><DataAnnotationsValidator /><FormErrors />
            <input type="hidden" name="OneOff.Key" value="@OneOff!.Key" />
            <fieldset disabled="@reviewing">
            <label for="description">@T("Description")</label><InputText id="description" @bind-Value="OneOff.Description" required />
            <label for="category">@T("Category")</label><InputText id="category" @bind-Value="OneOff.Category" required />
            <label for="amount">@T("Amount EUR")</label><InputMoney id="amount" @bind-Value="OneOff.Amount" />
            <label for="due">@T("Pay by")</label><InputDate id="due" @bind-Value="OneOff.DueOn" />
            </fieldset>
            @if (reviewing) { @foreach (var pair in OneOffValues) { <input type="hidden" name="@pair.Key" value="@pair.Value" /> } }
            @if (reviewing) { <p class="status-panel">@T("Issue {0} ({1}): {2} EUR, pay by {3}.", OneOff.Description, OneOff.Category, OneOff.Amount.ToString("0.00"), OneOff.DueOn.ToString("d MMM yyyy"))</p><button name="OneOff.Confirmed" value="true">@T("Confirm one-off request")</button> }
            else { <button name="OneOff.Confirmed" value="false">@T("Review one-off request")</button> }
        </EditForm>
    }
    else if (AvailableTask)
    {
        <p>@Explanation</p>
        <EditForm Model="Adjustment" method="post" FormName="adjustment" OnValidSubmit="Adjust"><DataAnnotationsValidator /><FormErrors />
            <input type="hidden" name="Adjustment.Key" value="@Adjustment!.Key" />
            <fieldset disabled="@reviewing">
            @if (TaskName == "discount")
            {
                <label for="adjust-fee">@T("Fee")</label><InputSelect id="adjust-fee" @bind-Value="Adjustment.FeeId">@foreach (var fee in fees.Where(fee => !fee.Retired)) { <option value="@fee.Id">@fee.Name</option> }</InputSelect>
                <label for="discount-type">@T("Discount type")</label><InputSelect id="discount-type" @bind-Value="Adjustment.Kind"><option value="Percentage">@T("Percentage")</option><option value="MonthlyPrice">@T("Replacement monthly price")</option></InputSelect>
                <label for="adjust-value">@T("Discount value")</label><InputMoney id="adjust-value" @bind-Value="Adjustment.Value" />
                <label for="adjust-start">@T("Starts on")</label><InputDate id="adjust-start" @bind-Value="Adjustment.Start" />
                <label for="adjust-end">@T("Through")</label><InputDate id="adjust-end" @bind-Value="Adjustment.Through" />
            }
            @if (TaskName is "withdraw" or "credit")
            {
                <label for="discount-choice">@T("Discount")</label><InputSelect id="discount-choice" @bind-Value="Adjustment.DiscountId"><option value="0">@T("Choose a discount")</option>
                    @foreach (var discount in view.Discounts.Where(discount => discount.WithdrawnAt == null)) { <option value="@discount.Id">@DiscountLabel(discount)</option> }
                </InputSelect>
            }
            @if (TaskName == "credit")
            {
                <label for="line-choice">@T("Completed purchase")</label><InputSelect id="line-choice" @bind-Value="Adjustment.LineId"><option value="0">@T("Choose a purchase")</option>
                    @foreach (var row in view.Invoices.SelectMany(invoice => invoice.Lines).Where(row => row.Line.State == LineState.Fulfilled)) { <option value="@row.Line.Id">@T("{0} · {1} · {2} EUR · bill #{3}", row.Line.Description, BillingDateText.PurchasePeriod(row.Line), row.Line.Amount.ToString("0.00"), row.Line.InvoiceId)</option> }
                </InputSelect>
                <input type="hidden" name="Adjustment.Value" value="@Adjustment.Value.ToString()" />
            }
            @if (TaskName == "grant")
            {
                <label for="grant-months">@T("Whole membership months")</label><InputNumber id="grant-months" @bind-Value="Adjustment.Months" />
                <input type="hidden" name="Adjustment.Through" value="@Adjustment.Through.ToString("yyyy-MM-dd")" />
            }
            @if (TaskName == "cancel")
            {
                <label for="bill-choice">@T("Bill with unfinished lines")</label><InputSelect id="bill-choice" @bind-Value="Adjustment.InvoiceId"><option value="0">@T("Choose a bill")</option>
                    @foreach (var invoice in view.Invoices.Where(invoice => invoice.Lines.Any(row => row.Line.State == LineState.Open))) { <option value="@invoice.Invoice.Id">@T("Bill #{0} · {1} · {2:0.00} EUR remaining", invoice.Invoice.Id, string.Join(", ", invoice.Lines.Select(row => row.Line.Description)), invoice.Remaining)</option> }
                </InputSelect>
            }
            @if (TaskName == "refund")
            {
                <label for="refund-source">@T("Refund source")</label><InputSelect id="refund-source" @bind-Value="Adjustment.Purchase"><option value="false">@T("Billing credit ({0} EUR available)", view.Balances.BillingCredit.ToString("0.00"))</option><option value="true">@T("Purchase balance ({0} EUR available)", view.Balances.PurchaseBalance.ToString("0.00"))</option></InputSelect>
                <label for="refund-value">@T("Completed refund amount EUR")</label><InputMoney id="refund-value" @bind-Value="Adjustment.Value" />
            }
            @if (TaskName == "unassign")
            {
                <label for="receipt-choice">@T("Posted bank receipt")</label><InputSelect id="receipt-choice" @bind-Value="Adjustment.ReceiptId"><option value="0">@T("Choose a receipt")</option>
                    @foreach (var receipt in receipts) { <option value="@receipt.Id">@T("{0} · {1} {2} · {3} · {4} · source {5}", receipt.ReceivedOn, receipt.Amount.ToString("0.00"), receipt.Currency, receipt.Counterparty, receipt.Reference, receipt.ExternalId)</option> }
                </InputSelect><small>@T("Latest 100 posted receipts. Completed purchases and spent money cannot be reversed here.")</small>
            }
            <label for="reason">@T(TaskName == "refund" ? "Completed bank refund reference and reason" : "Reason")</label><InputTextArea id="reason" @bind-Value="Adjustment.Reason" required maxlength="1000" />
            </fieldset>
            @if (reviewing) { @foreach (var pair in AdjustmentValues) { <input type="hidden" name="@pair.Key" value="@pair.Value" /> } }
            @if (reviewing) { <div class="status-panel"><h2>@T("Review proposed effect")</h2><p>@effect</p><p>@T("Reason: {0}", Adjustment.Reason)</p><p>@T("Current facts and authority will be rechecked when confirmed.")</p></div><button name="Adjustment.Confirmed" value="true">@T("Confirm adjustment")</button> }
            else { <button name="Adjustment.Confirmed" value="false">@T("Review adjustment")</button> }
        </EditForm>
    }
    @if (TaskName.Length > 0) { <p><a href="@CancelUrl">@T("Cancel and return")</a></p> }
    </section>
    @if (UserId is null)
    {
    <details class="financial-history" open="@(Page > 1)"><summary>@T("Financial history and balance statements")</summary>
    <h2>@T("Balance statements")</h2>
    <p>@T("Running statements are derived from the immutable journal.") <a href="/admin/payments">@T("Open Payments and accounting for the full journal export and reconciliation")</a>.</p>
    @foreach (var statement in view.Statements)
    {
        <h3>@T(StatementTitle(statement.Balance))</h3>
        <p>@T("Closing balance: {0:0.00} EUR", statement.ClosingBalance)
            @if (statement.HasMore) { <span> @T("· showing a page")</span> }
        </p>
        <table tabindex="0"><caption>@T(StatementTitle(statement.Balance))</caption><thead><tr><th scope="col">@T("Effective")</th><th scope="col">@T("Recorded")</th><th scope="col">@T("Description")</th><th scope="col">@T("Amount EUR")</th><th scope="col">@T("Running balance EUR")</th><th scope="col">@T("Source")</th></tr></thead><tbody>
        @foreach (var line in statement.Lines)
        {
            <tr id="movement-@line.MovementId"><td>@line.EffectiveOn</td><td>@line.RecordedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@line.Description</td><td>@line.Amount.ToString("0.00")</td><td>@line.RunningBalance.ToString("0.00")</td>
                <td>
                    @if (line.ReceiptId is { } receiptId) { <span>@T("Receipt #{0}", receiptId)</span> }
                    @if (line.InvoiceId is { } invoiceId) { <a href="@($"/billing/invoices/{invoiceId}/pdf")">@T("Invoice #{0}", invoiceId)</a> }
                    @if (line.InvoiceLineId is { } lineId) { <span>@T("line #{0}", lineId)</span> }
                    @if (line.DiscountId is { } discountId) { <span>@T("discount #{0}", discountId)</span> }
                    @if (line.ReversesMovementId is { } reversalId) { <a href="@(Navigation.Uri.Split('#')[0] + $"#movement-{reversalId}")">@T("reverses #{0}", reversalId)</a> }
                    @if (line.LotId is { } lotId) { <span>@T("lot #{0} ({1} original, {2} remaining)", lotId, line.LotOriginalAmount?.ToString("0.00"), line.LotRemaining?.ToString("0.00"))</span> }
                </td>
            </tr>
        }
        </tbody></table>
    }
    @if (Page > 1 || view.Statements.Any(x => x.HasMore))
    {
        <p>
            @if (Page > 1) { <a href="@Navigation.GetUriWithQueryParameter("page", Page - 1)">@T("Previous")</a> }
            @if (view.Statements.Any(x => x.HasMore)) { <a href="@Navigation.GetUriWithQueryParameter("page", Page + 1)">@T("Next")</a> }
        </p>
    }
    <h2>@T("Discounts")</h2><ul>@foreach (var discount in view.Discounts) { <li>@T("#{0} · fee #{1} · {2} {3} · {4} · {5}", discount.Id, discount.FeeDefinitionId, discount.Kind, discount.Value, BillingDateText.Period(discount.StartsOn, discount.EndExclusive), (discount.WithdrawnAt is null ? "Current" : "Withdrawn"))</li> }</ul>
    <h2>@T("Command history")</h2><ul>@foreach (var operation in view.History) { <li>@operation.OccurredAt.ToString("u") · @operation.Kind · @(operation.ActorId is { } actorId ? $"actor #{actorId}" : "System") · @operation.Reason · @operation.Id</li> }</ul>
    </details>
    }
}
</div>
