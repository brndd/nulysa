@page "/admin/applications"
@attribute [Authorize(Policy = "Administrator")]
@using Nulysa.Membership
@inject MembershipQueries Queries
@inject AuthenticationStateProvider Authentication
@inject AssociationClock Clock
@inject IConfiguration Configuration
@inject UiFeedback Feedback

<AdminPageHeader Title="Application review" />
<AdminSectionTabs Destination="applications" />
<p>Only email-verified applications awaiting a decision appear here (up to 100).</p>
<p class="field-help">Approval establishes membership and login before payment and creates the initial membership bill.</p>
@if (notice is not null) { <p role="status" class="success-notice">@notice</p> }
@if (applications.Count == 0) { <p>No verified applications are awaiting a decision.</p> }
<div class="application-list detail-workspace">
    @foreach (var application in applications) { <ApplicationReviewCard Application="application" @key="application.Id" /> }
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    private string? notice;
    private List<ApplicationReview> applications = [];
    protected override async Task OnInitializedAsync()
    {
        notice = Feedback.Read(HttpContext);
        applications = await Queries.Applications((await Authentication.GetAuthenticationStateAsync()).User);
    }
}
