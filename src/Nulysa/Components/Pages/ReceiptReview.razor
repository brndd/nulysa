@page "/admin/payments/{ReceiptId:long}"
@attribute [Authorize(Policy = "Administrator")]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nulysa.Billing
@inject AdministrationBillingQueries Administration
@inject BillingQueries Queries
@inject BillingCommands Commands
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject UiFeedback Feedback

<AdminPageHeader Title="Review bank transaction" Trail="@(new BreadcrumbItem[] { new("Payment review", "/admin/payments"), new("Review bank transaction") })" />
<div class="detail-workspace">
@if (receipt is not null)
{
    <div class="member-subject"><h2>@receipt.Amount.ToString("0.00") @receipt.Currency · @receipt.ReceivedOn</h2>
        <p>@receipt.Counterparty · @receipt.Message</p><p>Reference: @receipt.Reference</p><p><strong>@receipt.ReviewReason</strong></p>
        <details><summary>Original source facts</summary><p>Receipt #@receipt.Id · @receipt.Source / @receipt.SourceAccount / @receipt.ExternalId · imported @receipt.ImportedAt.ToString("u")</p></details>
    </div>
    @if (error is not null) { <p role="alert">@error</p> }
    @if (receipt.State is not (ReceiptState.New or ReceiptState.Review)) { <p>This transaction has already been processed: @receipt.State. Reload related balances before any further correction.</p> }
    else
    {
        <form method="get" class="filter-panel">
            <label for="purpose">Disposition / purpose</label><select id="purpose" name="purpose">
                <option value="">Choose a purpose</option>
                @foreach (var purpose in Purposes) { <option value="@purpose.Key" selected="@(Purpose == purpose.Key)">@purpose.Value</option> }
            </select>
            <label for="member-search">Find member by name, email or member number</label><input id="member-search" name="q" value="@Search" maxlength="200" />
            @if (MemberAccount is not null) { <input type="hidden" name="account" value="@MemberAccount" /> }
            <button>Choose purpose / search</button>
        </form>
        @if (member is not null) { <p><strong>@member.Name · Member #@member.UserId · @member.Email</strong> <a href="@($"/admin/payments/{ReceiptId}?purpose={Purpose}")">Choose a different member</a></p> }
        else if (Purpose != "ignore")
        {
            <p>Search returns up to 25 live members. Refine the search if needed. Pending-deletion accounts must be restored before assigning money.</p>
            <ul>@foreach (var candidate in members) { <li><a href="@($"/admin/payments/{ReceiptId}?purpose={Purpose}&account={candidate.AccountId}")">@candidate.Name · #@candidate.UserId · @candidate.Email</a></li> }</ul>
        }
        @if (Purposes.ContainsKey(Purpose) && (Purpose == "ignore" || member is not null))
        {
            <EditForm Model="Input" method="post" FormName="review-receipt" OnValidSubmit="Submit">
                <DataAnnotationsValidator /><ValidationSummary />
                <input type="hidden" name="Input.Key" value="@Input!.Key" />
                <fieldset disabled="@reviewing">
                @if (Purpose is "group" or "invoice")
                {
                    <label for="destination">@(Purpose == "group" ? "Recurring billing group" : "One-off bill")</label>
                    <InputSelect id="destination" @bind-Value="Input.Target"><option value="0">Choose a destination</option>
                        @foreach (var choice in destinations) { <option value="@choice.Key">@choice.Value</option> }
                    </InputSelect>
                }
                <label for="review-reason">Reason</label><InputTextArea id="review-reason" @bind-Value="Input.Reason" required maxlength="1000" />
                </fieldset>
                @if (reviewing) { <input type="hidden" name="Input.Target" value="@Input.Target" /><input type="hidden" name="Input.Reason" value="@Input.Reason" /> }
                @if (reviewing)
                {
                    <div class="status-panel"><h2>Review proposed disposition</h2><p>@effect</p><p>Reason: @Input.Reason</p><p>Source facts are retained. Assignment can immediately fund valid purchases and change coverage. Availability and eligibility are checked again when confirmed.</p></div>
                    <button name="Input.Confirmed" value="true">Confirm disposition</button>
                }
                else { <button name="Input.Confirmed" value="false">Review disposition</button> }
            </EditForm>
        }
    }
}
</div>
