@page "/apply"
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("verification")]
@using Nulysa.Membership
@using System.ComponentModel.DataAnnotations
@inject MembershipCommands Commands
@inject IConfiguration Configuration

<PageTitle>@T("Apply for membership") — @Configuration["Association:Name"]</PageTitle>
<h1>@T("Apply for membership")</h1>
@if (sent)
{
    <p role="status">@T("If this address is eligible, a verification email has been queued. Check your email before administrator review. You cannot log in until approval.")</p>
}
else
{
    @if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
    <EditForm Model="Input" method="post" FormName="application" OnValidSubmit="Submit">
        <DataAnnotationsValidator /><FormErrors />
        <input type="hidden" name="RequestId" value="@RequestId" />
        <Nulysa.Components.ProfileFields Input="Input!.Profile" Prefix="Input.Profile" />
        <p><label for="application-email">@T("Email")</label> <InputText id="application-email" @bind-Value="Input.Email" type="email" required maxlength="256" autocomplete="email" /></p>
        <p><label for="application-message">@T("Message to administrators")</label> <InputTextArea id="application-message" @bind-Value="Input.Message" required maxlength="4000" /></p>
        <p><InputCheckbox id="terms" @bind-Value="Input.AcceptTerms" /> <label for="terms">@T("I accept the association's membership terms.")</label> <a href="/membership-terms">@T("Read membership terms")</a></p>
        <button type="submit">@T("Submit application")</button>
    </EditForm>
}
<p><a href="/apply/resend">@T("Resend verification email")</a> · <a href="/Account/Login">@T("Log in")</a></p>

@code {
    [SupplyParameterFromForm(FormName = "application")] public ApplicationInput? Input { get; set; }
    [SupplyParameterFromForm(FormName = "application")] public Guid? RequestId { get; set; }
    private bool sent;
    private string? error;
    protected override void OnInitialized() { Input ??= new(); RequestId ??= Guid.NewGuid(); }
    private async Task Submit()
    {
        try { await Commands.Apply(RequestId!.Value, Input!); sent = true; }
        catch (ValidationException ex) { error = ex.Message; }
    }
}
