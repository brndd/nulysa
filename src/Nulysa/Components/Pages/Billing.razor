@page "/billing"
@page "/services"
@page "/admin/members/{UserId:long}"
@page "/admin/members/{UserId:long}/billing"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Nulysa.Accounts
@using Nulysa.Billing
@using Nulysa.Services
@inject BillingQueries Queries
@inject Nulysa.Membership.MembershipQueries MembershipQueries
@inject MemberPortalQueries PortalQueries
@inject Nulysa.Membership.AssociationClock Clock
@inject BillingCommands Commands
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject Nulysa.Components.UiFeedback Feedback
@inject Microsoft.Extensions.Options.IOptions<BillingOptions> Options

@if (UserId is null)
{
    <PageTitle>@T(Title) — @Configuration["Association:Name"]</PageTitle>
    <h1>@T(Title)</h1>
}
else if (subject is null) { <AdminPageHeader Title="@Title" /> }
<div class="detail-workspace">
@if (subject is not null) { <MemberWorkspace Member="subject" ReturnUrl="@ReturnUrl" Section="@(ShowServices ? MemberSection.Overview : MemberSection.Billing)" /> }
@if (UserId is null)
{
    <nav class="section-navigation" aria-label="@T("Membership and payments")">
        <a href="/services" aria-current="@(ShowServices ? "page" : null)">@T("Account overview")</a>
        <a href="/billing" aria-current="@(ShowBillingDetails ? "page" : null)">@T("Billing details")</a>
    </nav>
}
@if (error is not null && !ShowTransferDialog) { <p role="alert">@ValidationText.Translate(error)</p> }
@if (notice is not null) { <p role="status" class="success-notice">@T(notice)</p> }
@if (view is not null)
{
    @if (actionReview is not null)
    {
        <section class="status-panel" aria-labelledby="review-heading">
            <h2 id="review-heading">@T("Review service change")</h2>
            <p>@T(actionReview)</p>
            <p>@T("Available billing credit: {0} EUR. Valid bills may use this automatically. Prices and eligibility are checked again when you confirm.", Money(view.Balances.BillingCredit))</p>
            <EditForm Model="Action" method="post" FormName="confirm-action" OnSubmit="Submit">
                <input type="hidden" name="Action.Key" value="@Action!.Key" />
                <input type="hidden" name="Action.Name" value="@Action.Name" />
                <input type="hidden" name="Action.Id" value="@Action.Id" />
                <input type="hidden" name="Action.Months" value="@Action.Months" />
                <input type="hidden" name="Action.Grant" value="@Action.Grant.ToString().ToLowerInvariant()" />
                <input type="hidden" name="Action.Confirmed" value="true" />
                <button>@T("Confirm service change")</button> <a href="@Navigation.Uri">@T("Cancel")</a>
            </EditForm>
        </section>
    }
    else
    {
    @if (ShowServices && (OutstandingBills.Count > 0 || pendingEmail is not null || view.Membership.IsMembershipGrace))
    {
        <section class="payment-panel payment-attention" aria-labelledby="attention-heading">
            <h2 id="attention-heading">@T("Needs your attention")</h2>
            @if (OutstandingBills.Count > 0)
            {
                <p>@T("Outstanding bills needing payment: {0}.", OutstandingBills.Count)
                    <a href="@BillingUrl">@T("View outstanding bills and payment instructions")</a>.
                </p>
            }
            @if (view.Membership.IsMembershipGrace) { <p>@T("Membership remains active during grace. Review your membership payment before grace ends.")</p> }
            @if (pendingEmail is not null) { <p>@T("New email awaiting verification: {0}.", pendingEmail) <a href="/profile#email">@T("Review email change")</a>.</p> }
        </section>
    }
    @if (ShowServices)
    {
    <div class="status-panel">
        <strong>@(view.Membership.State == StandingState.MembershipInactive ? T("Membership inactive") : T("Membership: {0}", T(view.Membership.Description)))</strong>
        @if (view.Membership.ActiveUntilExclusive is not null) { <p><StandingThroughDate Standing="view.Membership" /></p> }
    </div>
    }
    @if (ShowBillingDetails)
    {
        <nav class="on-this-page" aria-label="@T("On this page")"><span>@T("On this page:")</span>
            <a href="@SectionLink("outstanding-bills")">@T("Outstanding bills")</a>
            <a href="@PageLink("billsPage", CurrentBillsPage, "bill-history")">@T("Previous bills")</a>
            <a href="@SectionLink("transactions")">@T("Transaction history")</a>
        </nav>
        <section id="outstanding-bills" class="payment-panel @(OutstandingBills.Count > 0 ? "payment-attention" : "")" aria-labelledby="outstanding-heading">
            <h2 id="outstanding-heading">@T("Outstanding bills")</h2>
            @if (OutstandingBills.Count == 0) { <p>@T("No bills currently request payment.")</p> }
            else
            {
                <p>@T("These bills need your attention. Each has its own payment reference. Unpaid requests expire; they are not debt.")</p>
                @foreach (var invoice in OutstandingBills) { <Nulysa.Components.BillSummary Invoice="invoice" DetailsUrl="@InvoiceUrl(invoice.Invoice.Id)" /> }
            }
            @if (!view.Membership.Active) { <p>@T("You do not need to pay expired bills.") <a href="@OverviewUrl">@T("Review membership return options")</a></p> }
        </section>
    }
    @if (ShowBalances)
    {
    <section id="funds" class="payment-panel" aria-labelledby="balances-heading">
        <h2 id="balances-heading">@T("Current balances")</h2>
        <div class="balance-cards">
            <div><h3>@T("Available billing credit")</h3><p class="balance-amount">@T("{0} EUR", Money(view.Balances.BillingCredit))</p><p>@T("Automatically used for recurring bills.")</p>
                <small class="balance-note">@T("Allocated to unfinished bills: {0} EUR — not included above or available to transfer.", Money(view.Balances.Held))</small>
            </div>
            @if (Options.Value.PurchaseBalanceEnabled)
            {
                <div><h3>@T("Available purchase balance")</h3><p class="balance-amount">@T("{0} EUR", Money(view.Balances.PurchaseBalance))</p><p>@T("For explicit purchases; not automatically used for bills.")</p>
        <details class="deposit-details">
        <summary>@T("Add purchase funds")</summary>
        <dl><dt>@T("Recipient")</dt><dd>@Configuration["Association:Name"]</dd>
            <dt>@T("IBAN")</dt><dd class="payment-reference">@Options.Value.Iban</dd>
            <dt>@T("Purchase-deposit reference")</dt><dd class="payment-reference">@view.DepositReference</dd></dl>
        <p>@T("Use this reference only for deliberate purchase deposits, not to pay a bill. Deposits become available after bank confirmation; they do not buy services or reserve storage automatically.")</p>
        </details>
                </div>
            }
        </div>
        @if (Options.Value.PurchaseBalanceEnabled)
        {
            <ActionDialog Id="transfer-heading" Label="@T("Move funds between balances")" Title="@T("Transfer available funds")" Open="@ShowTransferDialog">
                @if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
                @if (transferReview)
                {
        <div>
            <h3>@T("Review transfer")</h3>
            <p>@T(Transfer!.ToPurchase ? "Move {0:0.00} EUR from billing credit to purchase balance." : "Move {0:0.00} EUR from purchase balance to billing credit.", Transfer.Amount.Value)</p>
            <p>@T("Available source balance: {0} EUR.", Money(Transfer.ToPurchase ? view.Balances.BillingCredit : view.Balances.PurchaseBalance))</p>
            <p>@T("Moving money into billing credit immediately funds valid recurring bills. Allocated or spent money cannot be transferred back. This is an internal transfer, not a bank payment.")</p>
            <EditForm Model="Transfer" method="post" FormName="confirm-transfer" OnValidSubmit="TransferFunds">
                <DataAnnotationsValidator /><FormErrors />
                <input type="hidden" name="Transfer.Key" value="@Transfer.Key" />
                <input type="hidden" name="Transfer.Amount" value="@Transfer.Amount.ToString()" />
                <input type="hidden" name="Transfer.ToPurchase" value="@Transfer.ToPurchase.ToString().ToLowerInvariant()" />
                <input type="hidden" name="Transfer.Confirmed" value="true" />
                <button>@T("Confirm transfer")</button>
            </EditForm>
        </div>
                }
                else
                {
                    <p>@T("Available billing credit: {0} EUR · Purchase balance: {1} EUR.", Money(view.Balances.BillingCredit), Money(view.Balances.PurchaseBalance))</p>
        <EditForm Model="Transfer" method="post" FormName="transfer" OnValidSubmit="TransferFunds">
            <DataAnnotationsValidator /><FormErrors /><input type="hidden" name="Transfer.Key" value="@Transfer!.Key" />
            <p><label for="transfer-amount">@T("Amount (EUR)")</label> <InputMoney id="transfer-amount" @bind-Value="Transfer.Amount" /></p>
            <p><label for="transfer-direction">@T("From / to")</label>
                <InputSelect id="transfer-direction" @bind-Value="Transfer.ToPurchase">
                    <option value="false">@T("Purchase balance → billing credit")</option>
                    <option value="true">@T("Billing credit → purchase balance")</option>
                </InputSelect></p>
            <p>@T("Moving money into billing credit immediately funds valid recurring bills. Held or spent money cannot be transferred back.")</p>
            <button>@T("Transfer available funds")</button>
        </EditForm>
                }
            </ActionDialog>
        }
    </section>
    }
    <DiscountSummary View="view" />
    @if (ShowServices && !view.Membership.Active)
    {
        var returnInvoice = view.Invoices.FirstOrDefault(invoice => invoice.Lines.Any(line => line.Line.Purpose == PurchasePurpose.Resumption && line.Line.State == LineState.Open && line.Line.PaymentCutoffExclusive > Clock.Today));
        @if (returnInvoice is not null)
        {
            <p>@T("A return-period request is already available.") <a href="@InvoiceUrl(returnInvoice.Invoice.Id)">@T("Review your return-period bill")</a>.</p>
        }
        else if (Options.Value.AutomaticMembershipReactivation || board)
        {
        <EditForm Model="Action" method="post" FormName="billing-action" OnSubmit="Submit">
            <input type="hidden" name="Action.Key" value="@Action!.Key" /><button name="Action.Name" value="resume">@T("Request membership return period")</button>
        </EditForm>
        }
        @if (!Options.Value.AutomaticMembershipReactivation) { <p>@T("Contact an administrator to request a membership return period.")</p> }
    }
    @if (ShowBillingDetails)
    {
        <details id="bill-history" class="payment-panel" open="@(BillsPage is not null)">
            <summary>@T("Previous bills ({0})", PreviousBillsCount)</summary>
            <p>@T("Completed, closed and other bills that do not currently request payment. Showing up to {0} per page.", PageSize)</p>
            @if (PreviousBillsCount == 0) { <p>@T("No previous bills.")</p> }
            @foreach (var invoice in PreviousBillRows) { <Nulysa.Components.BillSummary Invoice="invoice" DetailsUrl="@InvoiceUrl(invoice.Invoice.Id)" /> }
            @if (CurrentBillsPage > 1 || PreviousBillsCount > CurrentBillsPage * PageSize)
            {
                <nav class="section-pagination" aria-label="@T("Previous bill pages")">
                    @if (CurrentBillsPage > 1) { <a href="@PageLink("billsPage", CurrentBillsPage - 1, "bill-history")">@T("Previous bills")</a> }
                    <span>@T("Page {0}", CurrentBillsPage)</span>
                    @if (PreviousBillsCount > CurrentBillsPage * PageSize) { <a href="@PageLink("billsPage", CurrentBillsPage + 1, "bill-history")">@T("Next bills")</a> }
                </nav>
            }
        </details>
    }
    @if (ShowServices)
    {
    <h2>@T("Services")</h2>
    <div class="service-list">
    @foreach (var subscription in view.Subscriptions)
    {
        <section class="service-row"><h3>@subscription.Name</h3>
            <p>@T(subscription.Standing.Description)
                <StandingThroughDate Standing="subscription.Standing" />
            </p>
            @if (subscription.Enrollment.RenewalStoppedAt is not null) { <p>@T("Renewal stopped. Remaining covered time keeps its original dates and still requires active membership.")</p> }
            else
            {
            <EditForm Model="Action" method="post" FormName="@($"stop-{subscription.Enrollment.ServiceDefinitionId}")" OnSubmit="Submit">
                <input type="hidden" name="Action.Key" value="@Action!.Key" /><input type="hidden" name="Action.Id" value="@subscription.Enrollment.Id" />
                <button name="Action.Name" value="stop">@T("Stop renewal; keep remaining covered time")</button>
                @if (board) { <button name="Action.Name" value="remove">@T("Remove immediately")</button> }
            </EditForm>
            }
            @if (board && subscription.Enrollment.RenewalStoppedAt is not null)
            {
                <EditForm Model="Action" method="post" FormName="@($"remove-{subscription.Enrollment.ServiceDefinitionId}")" OnSubmit="Submit">
                    <input type="hidden" name="Action.Key" value="@Action!.Key" /><input type="hidden" name="Action.Id" value="@subscription.Enrollment.Id" />
                    <button name="Action.Name" value="remove">@T("Remove immediately")</button>
                </EditForm>
            }
        </section>
    }
    @foreach (var service in services)
    {
        var isSubscribed = view.Subscriptions.Any(x => x.Enrollment.ServiceDefinitionId == service.Id);
        if (isSubscribed) { continue; }

        <section class="service-row"><h3>@service.Name</h3>
            @if (servicePrices.GetValueOrDefault(service.Id) is { } price) { <p>@T("Standard price: {0:0.00} EUR/month.", price)</p> }
            @if ((service.SelfSubscriptionAllowed || board) && view.Membership.Active && servicePrices.GetValueOrDefault(service.Id) is not null)
            {
                <EditForm Model="Action" method="post" FormName="@($"subscribe-{service.Id}")" OnSubmit="Submit">
                    <input type="hidden" name="Action.Key" value="@Action!.Key" /><input type="hidden" name="Action.Id" value="@service.Id" />
                    <label for="@($"interval-{service.Id}")">@T("Billing months")</label> <select id="@($"interval-{service.Id}")" name="Action.Months">@foreach (var months in Options.Value.AllowedIntervals) { <option value="@months">@months</option> }</select>
                    @if (board) { <p><input id="@($"grant-{service.Id}")" type="checkbox" name="Action.Grant" value="true" /> <label for="@($"grant-{service.Id}")">@T("Grant configured free days ({0}) to a returning subscriber", service.InitialFreeDays)</label></p> }
                    <button name="Action.Name" value="subscribe">@T("Subscribe")</button>
                </EditForm>
            }
            else if (!view.Membership.Active) { <p>@T("Active membership is required to subscribe. Restore membership first.")</p> }
            else if (service.SelfSubscriptionAllowed && servicePrices.GetValueOrDefault(service.Id) is null) { <p>@T("Pricing is not available. Contact an administrator before subscribing.")</p> }
            else { <p>@T("Not subscribed. An administrator must add this service.")</p> }
        </section>
    }
    </div>
    <section id="billing-settings" aria-labelledby="billing-settings-heading">
    <h2 id="billing-settings-heading">@T("Billing settings")</h2>
        <EditForm Model="Preference" method="post" FormName="invoice-preference" OnSubmit="SavePreference" class="preference-form" data-preference-form data-saved="@view.EmailInvoices.ToString().ToLowerInvariant()">
            <input type="hidden" name="Preference.Key" value="@Preference!.Key" />
            <div class="checkbox-field"><InputCheckbox id="email-invoices" @bind-Value="Preference.Enabled" /><label for="email-invoices">@T("Email invoice PDFs")</label></div>
            <button class="secondary-action">@T("Save preference")</button>
        </EditForm>
    <h3>@T("Billing intervals")</h3><p>@T("Changes affect the next unissued invoice. Issued requests and their references stay valid.")</p>
    @foreach (var item in view.Items)
    {
        var currentMonths = view.Groups.Single(group => group.Id == item.BillingGroupId).IntervalMonths;
        <EditForm Model="Action" method="post" FormName="@($"interval-{item.Id}")" OnSubmit="Submit">
            <input type="hidden" name="Action.Key" value="@Action!.Key" /><input type="hidden" name="Action.Id" value="@item.Id" />
            <label for="@($"item-{item.Id}")">@T("{0} (currently {1} months)", item.MembershipUserId is not null ? T("Membership") : view.Subscriptions.Single(x => x.Enrollment.Id == item.ServiceEnrollmentId).Name, currentMonths)</label>
            <select id="@($"item-{item.Id}")" name="Action.Months">@foreach (var months in Options.Value.AllowedIntervals) { <option value="@months" selected="@(months == currentMonths)">@months</option> }</select>
            <button name="Action.Name" value="interval">@T("Change next unissued period")</button>
        </EditForm>
    }
    </section>
    <h2>@T("Forecasts — not issued invoices")</h2>
    <ul>@foreach (var forecast in view.Forecasts) { <li>@T("{0} · {1} · {2} EUR · {3} months", forecast.Description, BillingDateText.Period(forecast.Start, forecast.EndExclusive), Money(forecast.Amount), forecast.Months)</li> }</ul>
    <details><summary>@T("Coverage history")</summary><ul>@foreach (var coverage in view.Coverage.OrderByDescending(x => x.StartsOn)) { <li>@T(coverage.Benefit.ToString()) @(view.Services.SingleOrDefault(x => x.Id == coverage.ServiceDefinitionId)?.Name) · @BillingDateText.Period(coverage.StartsOn, coverage.EndExclusive) · @(coverage.Source == CoverageSource.Purchase ? T("Purchased coverage") : T("Granted coverage"))</li> }</ul></details>
    }
    @if (ShowBillingDetails)
    {
    <section id="transactions" class="payment-panel" aria-labelledby="transactions-heading">
    <h2 id="transactions-heading">@T(ShowBillingDetails ? "Transaction history" : "Balance statements")</h2>
    @if (ShowBillingDetails) { <p>@T("Newest transactions first. Showing up to {0} changes to the selected balance per page.", PageSize)</p> }
    <p>@T("Available balances and funds already allocated to bills are separate. Transfers appear in both affected balances; they are not extra bank payments.")</p>
    @if (ShowBillingDetails)
    {
        <nav class="balance-filter" aria-label="@T("Transaction balances")">
            <a href="@BalanceLink("billing")" aria-current="@(SelectedBalance == BalanceKind.BillingCredit ? "page" : null)">@T("Billing credit")</a>
            @if (ShowPurchaseHistory) { <a href="@BalanceLink("purchase")" aria-current="@(SelectedBalance == BalanceKind.PurchaseBalance ? "page" : null)">@T("Purchase balance")</a> }
            <a href="@BalanceLink("allocated")" aria-current="@(SelectedBalance == BalanceKind.Held ? "page" : null)">@T("Allocated funds")</a>
        </nav>
    }
    @foreach (var statement in view.Statements.Where(statement => !ShowBillingDetails || statement.Balance == SelectedBalance))
    {
        var showStatement = statement.Balance != BalanceKind.PurchaseBalance
            || Options.Value.PurchaseBalanceEnabled
            || statement.Lines.Count > 0
            || statement.OpeningBalance != 0
            || statement.ClosingBalance != 0;
        if (!showStatement) { continue; }

        <h3>@T(StatementTitle(statement.Balance))</h3>
        <p>@T(statement.HasMore ? "Balance at end of this page: {0:0.00} EUR" : "Closing balance: {0:0.00} EUR", statement.ClosingBalance)
            @if (statement.HasMore) { <span> @T("· showing a page; use Next to see more")</span> }
        </p>
        @if (statement.Lines.Count == 0) { <p>@T("No transactions on this page.")</p> }
        else
        {
        <table tabindex="0" aria-label="@T(StatementTitle(statement.Balance))"><thead><tr><th scope="col">@T("Date")</th><th scope="col">@T("Transaction")</th><th scope="col">@T("Amount EUR")</th><th scope="col">@T("Running balance EUR")</th><th scope="col">@T("Details")</th></tr></thead><tbody>
        @foreach (var line in statement.Lines)
        {
            <tr id="movement-@line.MovementId"><td>@UiText.Date(line.EffectiveOn)</td><td>@T(MovementTitle(line.Kind))
                    @if (line.InvoiceId is { } billId) { <br /><a href="@InvoiceUrl(billId)">@T("Bill #{0}", billId)</a> }
                </td><td>@Money(line.Amount)</td><td>@Money(line.RunningBalance)</td>
                <td>
                    <details><summary>@T("Details")</summary><p>@line.Description</p><p>@T("Recorded (UTC): {0}", line.RecordedAt.ToString("yyyy-MM-dd HH:mm"))</p>
                    @if (line.ReceiptId is { } receiptId) { <span>@T("Receipt #{0}", receiptId)</span> }
                    @if (line.InvoiceId is { } invoiceId) { <a href="@($"/billing/invoices/{invoiceId}/pdf")">@T("Invoice #{0}", invoiceId)</a> }
                    @if (line.InvoiceLineId is { } lineId) { <span>@T("line #{0}", lineId)</span> }
                    @if (line.DiscountId is { } discountId) { <span>@T("discount #{0}", discountId)</span> }
                    @if (line.ReversesMovementId is { } reversalId) { <a href="@(Navigation.Uri.Split('#')[0] + $"#movement-{reversalId}")">@T("reverses #{0}", reversalId)</a> }
                    @if (line.LotId is { } lotId) { <span>@T("lot #{0} ({1} original, {2} remaining)", lotId, Money(line.LotOriginalAmount ?? 0), Money(line.LotRemaining ?? 0))</span> }
                    </details>
                </td>
            </tr>
        }
        </tbody></table>
        }
    }
    @if (HistoryPage > 1 || view.Statements.Any(statement => (!ShowBillingDetails || statement.Balance == SelectedBalance) && statement.HasMore))
    {
        <nav class="section-pagination" aria-label="@T("Transaction pages")">
            @if (HistoryPage > 1) { <a href="@PageLink("transactionsPage", HistoryPage - 1, "transactions")">@T("Previous transactions")</a> }
            <span>@T("Page {0}", HistoryPage)</span>
            @if (view.Statements.Any(statement => (!ShowBillingDetails || statement.Balance == SelectedBalance) && statement.HasMore)) { <a href="@PageLink("transactionsPage", HistoryPage + 1, "transactions")">@T("Next transactions")</a> }
        </nav>
    }
    </section>
    @if (ShowBillingDetails) { <p><a href="@(OverviewUrl + "#billing-settings")">@T("Manage billing settings")</a></p> }
    }
    @if (board && !ShowServices)
    {
        <section id="financial-history"><h2>@T("Financial command history")</h2>
        <ul>@foreach (var operation in view.History) { <li>@operation.OccurredAt.ToString("u") · @operation.Kind · @(operation.ActorId is { } actorId ? $"actor #{actorId}" : "System") · @operation.Reason</li> }</ul>
        </section>
    }
    @if (board) { <p><a href="@RegistryNavigation.MemberUrl(UserId!.Value, ReturnUrl, MemberSection.Actions)">@T("Financial actions and one-off requests")</a></p> }
    }
}
else { <p>@T("No billing account is available.")</p> }

</div>

@code {
    private string Path => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
    private bool ShowServices => Path == "services" || (UserId is not null && !Path.EndsWith("/billing", StringComparison.Ordinal));
    private bool ShowBalances => ShowServices;
    private bool ShowBillingDetails => !ShowServices;
    private string Title => ShowServices ? "Account overview" : "Billing details";
    private string LocalUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
    private string BillingUrl => UserId is { } id ? RegistryNavigation.MemberUrl(id, ReturnUrl, MemberSection.Billing) : "/billing";
    private string OverviewUrl => UserId is { } id ? RegistryNavigation.MemberUrl(id, ReturnUrl) : "/services";
    private string InvoiceUrl(long invoiceId) => UserId is { } id ? RegistryNavigation.BillUrl(id, invoiceId, ReturnUrl, LocalUrl) : $"/billing/invoices/{invoiceId}";
    private int CurrentBillsPage => view?.PreviousBillCount is { } count ? Math.Min(BillsPage ?? 1, Math.Max(1, (count + PageSize - 1) / PageSize)) : BillsPage ?? 1;
    private int PreviousBillsCount => view?.PreviousBillCount ?? PreviousBills.Count;
    private IEnumerable<InvoiceView> PreviousBillRows => view?.PreviousBillCount is not null ? PreviousBills : PreviousBills.Skip((CurrentBillsPage - 1) * PageSize).Take(PageSize);
    private int HistoryPage => TransactionsPage;
    private List<InvoiceView> OutstandingBills => view!.Invoices.Where(invoice => invoice.Invoice.ClosedAt is null && invoice.Remaining > 0).OrderBy(invoice => invoice.Invoice.DueOn).ThenBy(invoice => invoice.Invoice.Id).ToList();
    private List<InvoiceView> PreviousBills => view!.Invoices.Where(invoice => invoice.Invoice.ClosedAt is not null || invoice.Remaining == 0).OrderByDescending(invoice => invoice.Invoice.IssuedAt).ThenByDescending(invoice => invoice.Invoice.Id).ToList();
    private bool ShowPurchaseHistory => Options.Value.PurchaseBalanceEnabled || view!.Statements.Any(statement => statement.Balance == BalanceKind.PurchaseBalance && (statement.Lines.Count > 0 || statement.HasMore || statement.OpeningBalance != 0 || statement.ClosingBalance != 0));
    private BalanceKind SelectedBalance => Balance switch
    {
        "purchase" when ShowPurchaseHistory => BalanceKind.PurchaseBalance,
        "allocated" => BalanceKind.Held,
        _ => BalanceKind.BillingCredit
    };
    private string SectionLink(string section) => Navigation.Uri.Split('#')[0] + "#" + section;
    private string PageLink(string parameter, int page, string section) => Navigation.GetUriWithQueryParameter(parameter, page).Split('#')[0] + "#" + section;
    private string BalanceLink(string balance) => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["balance"] = balance, ["transactionsPage"] = null }).Split('#')[0] + "#transactions";
    public sealed class ActionInput
    {
        public Guid Key { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";
        public long Id { get; set; }
        public int Months { get; set; } = 1;
        public bool Grant { get; set; }
        public bool Confirmed { get; set; }
    }
    public sealed class TransferInput
    {
        public Guid Key { get; set; } = Guid.NewGuid();
        [MoneyRange("0.01", "999999999")] public MoneyAmount Amount { get; set; }
        public bool ToPurchase { get; set; }
        public bool Confirmed { get; set; }
    }
    public sealed class PreferenceInput { public Guid Key { get; set; } = Guid.NewGuid(); public bool Enabled { get; set; } }
    [Parameter] public long? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public int PageSize { get; set; } = 10;
    [SupplyParameterFromQuery] public int? BillsPage { get; set; }
    [SupplyParameterFromQuery] public int TransactionsPage { get; set; } = 1;
    [SupplyParameterFromQuery] public string? Balance { get; set; }
    [SupplyParameterFromForm] public ActionInput? Action { get; set; }
    [SupplyParameterFromForm] public TransferInput? Transfer { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-preference")] public PreferenceInput? Preference { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    private ClaimsPrincipal actor = null!; private BillingView? view; private List<ServiceDefinition> services = []; private bool board; private string? error;
    private string? notice;
    private string? pendingEmail;
    private Nulysa.Membership.RegistryEntry? subject;
    private Dictionary<long, decimal?> servicePrices = [];
    private string? actionReview;
    private bool transferReview;
    private bool ShowTransferDialog => ShowBalances && Options.Value.PurchaseBalanceEnabled &&
        (transferReview || (Transfer is not null && Transfer.Amount.Value != 0) ||
            (HttpContext.Request.HasFormContentType && HttpContext.Request.Form["_handler"].ToString() is "transfer" or "confirm-transfer"));
    protected override async Task OnInitializedAsync()
    {
        actor = (await Authentication.GetAuthenticationStateAsync()).User;
        notice = Feedback.Read(HttpContext);
        TransactionsPage = Math.Clamp(TransactionsPage, 1, 1_000_000);
        if (BillsPage is not null)
            BillsPage = Math.Clamp(BillsPage.Value, 1, 1_000_000);
        PageSize = PageSize <= 0 ? 10 : Math.Min(PageSize, 100);
        try
        {
            if (UserId is { } memberId)
            {
                subject = await MembershipQueries.Subject(actor, memberId, HttpContext.RequestAborted);
                if (subject is null)
                {
                    HttpContext.Response.StatusCode = 404;
                    return;
                }
            }
            view = UserId is null
                ? await Queries.Portal(actor, BillsPage ?? 1, HistoryPage, PageSize, ShowBillingDetails, HttpContext.RequestAborted)
                : await Queries.Member(actor, UserId.Value, skip: (HistoryPage - 1) * PageSize, take: PageSize, newestFirst: ShowBillingDetails);
            if (ShowServices)
            {
                services = await Queries.Services(actor);
                servicePrices = await PortalQueries.ServicePrices(actor, HttpContext.RequestAborted);
            }
        }
        catch (UnauthorizedAccessException) { HttpContext.Response.StatusCode = 403; return; }
        board = UserId is not null && HttpContext.User.IsInRole("Administrator");
        if (UserId is null && ShowServices)
            pendingEmail = await PortalQueries.PendingEmail(actor, HttpContext.RequestAborted);
        Action ??= new();
        Transfer ??= new();
        Preference ??= new() { Enabled = view?.EmailInvoices ?? true };
        // Static POST dispatch must recreate the confirmation form before its handler runs.
        if (Action.Confirmed)
            actionReview = "The selected service change will be rechecked before saving.";
        if (Transfer.Confirmed)
            transferReview = true;
    }
    private static string Money(decimal amount) => amount.ToString("0.00");
    private static string StatementTitle(BalanceKind balance) => balance switch
    {
        BalanceKind.BillingCredit => "Billing credit statement",
        BalanceKind.PurchaseBalance => "Purchase balance statement",
        _ => "Held/funding movements"
    };
    private async Task Submit() => await Handle(async () =>
    {
        if (Action!.Grant && !board)
            throw new ValidationException("Free-day grants must be made in the administration view.");

        var requiresReview = UserId is null && !Action!.Confirmed && Action.Name is "subscribe" or "stop" or "resume";
        if (requiresReview)
        {
            actionReview = DescribeAction();
            return;
        }
        switch (Action!.Name)
        {
            case "subscribe": await Commands.Subscribe(actor, view!.AccountId, Action.Id, Action.Months, board && Action.Grant, Action.Key); break;
            case "stop": case "remove": await Commands.StopService(actor, view!.AccountId, Action.Id, Action.Name == "remove", Action.Key, "Requested through service settings"); break;
            case "interval": await Commands.ChangeInterval(actor, view!.AccountId, Action.Id, Action.Months, Action.Key); break;
            case "resume": await Commands.ResumeMembership(actor, view!.AccountId, Action.Key); break;
            default: throw new ValidationException("Choose a billing action.");
        }
        SaveNotice(Action.Name switch
        {
            "stop" => "Renewal stopped. Remaining coverage keeps its original dates.",
            "interval" => "Billing interval saved for the next unissued period.",
            "resume" => "Return-period request processed. Review current bills and membership standing.",
            _ => "Service change saved. Review coverage and current bills."
        });
    });
    private string DescribeAction()
    {
        switch (Action!.Name)
        {
            case "subscribe":
                var service = services.SingleOrDefault(service => service.Id == Action.Id)
                    ?? throw new ValidationException("Service is unavailable.");
                var price = servicePrices.GetValueOrDefault(Action.Id)?.ToString("0.00") ?? T("unavailable");
                return T("Subscribe to {0} with a {1}-month billing interval. Base monthly price: {2} EUR before discounts/proration. The bill will show the actual charge, including any free time, discount or prorated period. This starts recurring renewal until you stop it.", service.Name, Action.Months, price);
            case "stop":
                var subscription = view!.Subscriptions.SingleOrDefault(subscription => subscription.Enrollment.Id == Action.Id)
                    ?? throw new ValidationException("Subscription is unavailable.");
                return T("Stop renewal of {0}. Keep remaining paid/granted time; cancel only unfinished requests for this service and return their unused funding to billing credit. No automatic refund of purchased time.", subscription.Name);
            default:
                return T("Request a prorated membership return period on your existing schedule. This does not require paying expired bills or inactive months. Available credit may fund it immediately.");
        }
    }
    private Task TransferFunds() => Handle(async () =>
    {
        if (!Transfer!.Confirmed)
        {
            var available = Transfer.ToPurchase ? view!.Balances.BillingCredit : view!.Balances.PurchaseBalance;
            if (Transfer.Amount > available)
                throw new ValidationException("The amount exceeds your available source balance.");
            transferReview = true;
            return;
        }
        await Commands.Transfer(actor, view!.AccountId, Transfer.Key, Transfer.Amount, Transfer.ToPurchase);
        SaveNotice("Transfer completed. Current available and allocated balances are shown below.");
    });
    private Task SavePreference() => Handle(async () =>
    {
        await Commands.SetEmailInvoices(actor, view!.AccountId, Preference!.Enabled, Preference.Key);
        SaveNotice("Invoice email preference saved.");
    });
    private void SaveNotice(string message)
    {
        Feedback.Save(HttpContext, message);
        Navigation.NavigateTo(Navigation.Uri);
    }
    private async Task Handle(Func<Task> action)
    {
        if (view is null) return;
        try { await action(); }
        catch (ValidationException ex) { error = ex.Message; }
        catch (UnauthorizedAccessException) { error = "This action is not permitted for this account."; }
    }
    private static string MovementTitle(MovementKind kind) => kind switch
    {
        MovementKind.ReceiptToLine => "Payment allocated to a bill",
        MovementKind.ReceiptToBilling => "Payment added to billing credit",
        MovementKind.ReceiptToPurchase => "Purchase balance deposit",
        MovementKind.BillingToLine => "Billing credit allocated to a bill",
        MovementKind.LineToBilling => "Unused allocated funds returned to billing credit",
        MovementKind.LinePurchase => "Purchase completed",
        MovementKind.BillingToPurchase => "Transfer to purchase balance",
        MovementKind.PurchaseToBilling => "Transfer to billing credit",
        MovementKind.PurchaseCredit => "Credit adjustment",
        MovementKind.BillingRefund or MovementKind.PurchaseRefund => "Refund recorded",
        MovementKind.BillingReceiptReversal or MovementKind.PurchaseReceiptReversal => "Payment allocation reversed",
        _ => "Balance adjustment"
    };
}
