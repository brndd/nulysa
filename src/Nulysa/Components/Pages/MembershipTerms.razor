@page "/membership-terms"
@attribute [AllowAnonymous]
@inject IConfiguration Configuration

<PageTitle>@T("Membership terms") — @Configuration["Association:Name"]</PageTitle>
<h1>@T("Membership terms")</h1>
@if (Configuration["Association:TermsUrl"] is { Length: > 0 } url)
{
    <p>@T("Read the association's membership terms and privacy information before applying.") <a href="@url">@T("Open membership terms and privacy information")</a></p>
}
else
{
    <p>@T("This is a development registry. Association-specific terms and privacy information must be supplied before public deployment. Do not submit real personal data.")</p>
}
