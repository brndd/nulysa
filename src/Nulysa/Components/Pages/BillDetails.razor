@page "/billing/invoices/{InvoiceId:long}"
@page "/admin/members/{UserId:long}/billing/invoices/{InvoiceId:long}"
@attribute [Authorize]
@using Nulysa.Billing
@inject BillingQueries Queries
@inject AdministrationBillingQueries Administration
@inject Nulysa.Membership.MembershipQueries Members
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<BillingOptions> Options

@if (UserId is null)
{
    <PageTitle>@T("Bill details")</PageTitle>
    <h1>@T("Bill details")</h1>
    <p><a href="/billing">@T("Back to payments")</a> · <a href="/services">@T("Membership and services")</a></p>
}
else if (subject is not null)
{
    <MemberWorkspace Member="subject" Section="MemberSection.Billing" ReturnUrl="@ReturnUrl" Title="@T("Bill #{0}", InvoiceId)" />
    <p><a href="@BillingReturn">@T(ReturnLabel)</a></p>
}
else { <AdminPageHeader Title="@T("Bill details")" /> }
@if (error is not null) { <p role="alert">@ValidationText.Translate(error)</p> }
@if (invoice is not null)
{
    <h2>@T("Invoice #{0}", invoice.Invoice.Id)</h2>
    <p>@T(invoice.Invoice.ClosedAt is null ? "Open payment request" : "Closed payment request")</p>
    <InvoiceFunding Invoice="invoice" />
    @if (invoice.Invoice.ClosedAt is null && invoice.Remaining > 0)
    {
        <section class="payment-instructions" aria-labelledby="payment-heading">
            <h2 id="payment-heading">@T("Pay by bank transfer")</h2>
            <dl><dt>@T("Recipient")</dt><dd>@Configuration["Association:Name"]</dd>
                <dt>@T("IBAN")</dt><dd class="payment-reference">@Options.Value.Iban</dd>
                <dt>@T("Reference")</dt><dd class="payment-reference">@invoice.Reference</dd>
                <dt>@T("Remaining amount")</dt><dd>@T("{0} EUR", invoice.Remaining.ToString("0.00"))</dd>
                @if (invoice.Invoice.DueOn is { } due) { <dt>@T("Pay by")</dt><dd>@UiText.Date(due)</dd> }
            </dl>
            <p>@T("Use this bill's reference, not your purchase-deposit reference. Bank transfers appear after confirmation and processing; access may not update immediately.")</p>
            <p>@T("Unpaid requests expire; they are not debt. A paid membership line remains paid even if another item is unfinished.")</p>
        </section>
    }
    else { <p>@T("No payment is requested for this bill.")</p> }
    <p><a href="@($"/billing/invoices/{InvoiceId}/pdf")">@T("Download current PDF")</a></p>
    @if (UserId is { } memberId && invoice.Lines.Any(row => row.Line.State == LineState.Open))
    {
        <p><a href="@(Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(RegistryNavigation.ActionUrl(memberId, "cancel", ReturnUrl, "/" + Navigation.ToBaseRelativePath(Navigation.Uri)), "invoice", InvoiceId.ToString()))">@T("Cancel unfinished bill")</a></p>
    }
}

@code {
    [Parameter] public long? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "backTo")] public string? BackTo { get; set; }
    private Nulysa.Membership.RegistryEntry? subject;
    private string BillingReturn => RegistryNavigation.BackTo(UserId!.Value, BackTo, ReturnUrl, MemberSection.Billing);
    private string ReturnLabel => AdminNavigation.Path(BillingReturn) == $"/admin/members/{UserId}" ? "Back to account overview" : "Back to billing details";
    [Parameter] public long InvoiceId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;
    private InvoiceView? invoice;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        invoice = null;
        error = null;
        try
        {
            var actor = (await Authentication.GetAuthenticationStateAsync()).User;
            if (UserId is { } memberId)
            {
                subject = await Members.Subject(actor, memberId, HttpContext.RequestAborted);
                if (subject is null || !await Administration.InvoiceBelongsToMember(actor, InvoiceId, memberId, HttpContext.RequestAborted))
                    throw new KeyNotFoundException("Bill not found for this member.");
            }
            invoice = await Queries.InvoiceForMember(actor, InvoiceId, HttpContext.RequestAborted);
        }
        catch (UnauthorizedAccessException) { HttpContext.Response.StatusCode = 403; error = "You cannot view this bill."; }
        catch (KeyNotFoundException) { HttpContext.Response.StatusCode = 404; error = "Bill not found."; }
    }
}
