@page "/"
@attribute [Authorize]
@inject IConfiguration Configuration

<PageTitle>Member portal — @Configuration["Association:Name"]</PageTitle>
<h1>Member portal</h1>
<p class="page-intro">Your membership, payments and association services in one place.</p>
<div class="overview-links">
    <a href="/services"><strong>Membership and services</strong><span>Review membership standing, coverage and service renewals.</span></a>
    <a href="/billing"><strong>Bills and payments</strong><span>View bills, payment instructions and PDFs.</span></a>
    <a href="/profile"><strong>My details</strong><span>Keep your contact details and email address up to date.</span></a>
</div>
