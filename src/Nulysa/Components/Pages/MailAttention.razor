@page "/admin/mail-attention"
@attribute [Authorize(Policy = "Administrator")]
@using Nulysa.Membership
@using Nulysa.Communications
@using Microsoft.AspNetCore.WebUtilities
@inject MembershipQueries Queries
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration

<AdminPageHeader Title="@T("Mail problems")" />
<AdminSectionTabs Destination="mail" />
<p class="page-intro">@T("Essential mail includes verification, welcome, security, membership and deletion notices. Invoice emails are optional and can be included below.")</p>
<div class="status-panel operational-warning">
    <p>@T("Uncertain delivery requires reconciliation.")</p>
</div>
<form method="get" action="/admin/mail-attention" class="filter-panel">
    <div class="filter-fields">
        <div><label for="mail-state">@T("Delivery state")</label><select id="mail-state" name="state" value="@State">
            <option value="all" selected="@(State == "all")">@T("Failed and uncertain")</option>
            <option value="failed" selected="@(State == "failed")">@T("Failed")</option>
            <option value="review" selected="@(State == "review")">@T("Uncertain (Review)")</option>
        </select></div>
        <div><label for="mail-kind">@T("Message scope")</label><select id="mail-kind" name="scope" value="@Scope">
            <option value="essential" selected="@(Scope == "essential")">@T("Essential mail")</option>
            <option value="all" selected="@(Scope == "all")">@T("All mail, including invoices")</option>
        </select></div>
    </div>
    <button>@T("Filter mail")</button>
</form>
@if (result is not null)
{
    @if (result.Total == 0) { <p>@T("No known mail problems match these filters. This does not establish that mail delivery is healthy.")</p> }
    else
    {
        <p>@T("{0} messages need attention. Oldest first, up to {1} per page. Times are UTC.", result.Total, MailAttentionPage.PageSize)</p>
        <ul class="mail-attention-list">
            @foreach (var delivery in result.Entries)
            {
                <li class="status-panel">
                    <strong>@MailKindLabel.Text(delivery.Kind) · @(delivery.State == DeliveryState.Review ? T("Uncertain — reconcile with provider") : T("Failed — delivery not confirmed"))</strong>
                    <dl><dt>@T("Delivery ID")</dt><dd class="supporting-reference">@delivery.Id</dd>
                        <dt>@T("Provider reference")</dt><dd class="supporting-reference">@(delivery.ProviderId ?? T("None recorded"))</dd>
                        <dt>@T("Created / attempts")</dt><dd>@T("{0} · {1} attempts", delivery.CreatedAt.ToString("u"), delivery.Attempts)</dd>
                    </dl>
                </li>
            }
        </ul>
        <nav class="section-pagination" aria-label="@T("Mail problem pages")">
            @if (result.Page > 1) { <a href="@PageUrl(result.Page - 1)">@T("Previous messages")</a> }
            <span>@T("Page {0} of {1}", result.Page, result.PageCount)</span>
            @if (result.Page < result.PageCount) { <a href="@PageUrl(result.Page + 1)">@T("Next messages")</a> }
        </nav>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "state")] public string? RequestedState { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? RequestedScope { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? RequestedPage { get; set; }
    private string State => RequestedState is "failed" or "review" ? RequestedState : "all";
    private string Scope => RequestedScope == "all" ? "all" : "essential";
    private MailAttentionPage? result;

    protected override async Task OnParametersSetAsync()
    {
        var page = int.TryParse(RequestedPage, out var number) ? number : 1;
        result = await Queries.MailFailures((await Authentication.GetAuthenticationStateAsync()).User, State, Scope == "essential", page);
    }

    private string PageUrl(int page) => QueryHelpers.AddQueryString("/admin/mail-attention", new Dictionary<string, string?> { ["state"] = State, ["scope"] = Scope, ["page"] = page.ToString() });
}
