@page "/admin/applications/{Id:guid}"
@attribute [Authorize(Policy = "Administrator")]
@using Nulysa.Membership
@inject MembershipQueries Queries
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration

<AdminPageHeader Title="@T("Review application")" Trail="@(new BreadcrumbItem[] { new("Application review", "/admin/applications"), new("Review application") })" />
@if (application is null) { <p>@T("This verified application is no longer awaiting review.")</p> }
else { <div class="detail-workspace"><ApplicationReviewCard Application="application" /></div> }

@code {
    [Parameter] public Guid Id { get; set; }
    private ApplicationReview? application;
    protected override async Task OnInitializedAsync()
    {
        application = (await Queries.Applications((await Authentication.GetAuthenticationStateAsync()).User, Id)).SingleOrDefault();
    }
}
