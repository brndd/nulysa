@using Nulysa.Billing

@if (Standing.ActiveUntilExclusive is { } endExclusive)
{
    <span>@T(Standing.State is StandingState.Covered or StandingState.CoveredWithRenewalStopped ? "Covered through {0:d MMM yyyy}" : "Benefits available through {0:d MMM yyyy}", endExclusive.AddDays(-1))</span>
}

@code {
    [Parameter, EditorRequired] public Standing Standing { get; set; } = null!;
}
