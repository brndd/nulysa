@page
@model Nulysa.Pages.Account.SetPasswordModel
@{ ViewData["Title"] = T("Set password"); }
<h1>@T("Set password")</h1>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Token" />
    <p><label asp-for="Password">@T("Password")</label> <input asp-for="Password" autocomplete="new-password" required maxlength="256" /></p>
    <p><label asp-for="ConfirmPassword">@T("Confirm password")</label> <input asp-for="ConfirmPassword" autocomplete="new-password" required maxlength="256" /></p>
    <button type="submit">@T("Set password")</button>
</form>
