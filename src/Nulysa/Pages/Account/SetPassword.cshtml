@page
@model Nulysa.Pages.Account.SetPasswordModel
@{ ViewData["Title"] = "Set password"; }
<h1>Set password</h1>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Token" />
    <p><label asp-for="Password"></label> <input asp-for="Password" autocomplete="new-password" required maxlength="256" /></p>
    <p><label asp-for="ConfirmPassword">Confirm password</label> <input asp-for="ConfirmPassword" autocomplete="new-password" required maxlength="256" /></p>
    <button type="submit">Set password</button>
</form>
