@page
@model Nulysa.Pages.Account.ConfirmEmailModel
@{ ViewData["Title"] = T("Confirm email change"); }
<h1>@T("Confirm email change")</h1>
<p>@T("Your existing email remains your login address until you confirm this change.")</p>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="Token" />
    <button type="submit">@T("Confirm new email")</button>
</form>
