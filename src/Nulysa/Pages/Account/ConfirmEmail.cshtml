@page
@model Nulysa.Pages.Account.ConfirmEmailModel
@{ ViewData["Title"] = "Confirm email change"; }
<h1>Confirm email change</h1>
<p>Your existing email remains your login address until you confirm this change.</p>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="Token" />
    <button type="submit">Confirm new email</button>
</form>
