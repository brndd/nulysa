@page
@model Nulysa.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<h1>Reset password</h1>
@if (Model.Submitted) { <p role="status">If this address has an eligible account, a reset email has been queued. Requests are limited to once every minute.</p> }
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <p><label asp-for="Email"></label> <input asp-for="Email" autocomplete="email" required maxlength="256" /></p>
    <button type="submit">Send reset link</button>
</form>
