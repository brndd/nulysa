<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>nulysa-local-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Billing/Templates/**/*.typ" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep Blazor assets identical across the host and container SDK patch versions. -->
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.6.2" />
    <!-- Override OpenIddict's transitive versions with the October security fixes. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
